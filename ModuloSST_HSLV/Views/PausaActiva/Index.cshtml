@model IEnumerable<ModuloSST_HSLV.Models.PausaActiva>
@{
    ViewBag.Title = "Pausas Activas";
}

<div class="row">
    <div class="col-md-12">
        <h2 class="text-primary">Gestión de Pausas Activas</h2>
        <hr />

        <div style="margin-bottom: 20px;">
            @* Botón Registrar (Estilo Verde) *@
            <a href="@Url.Action("Registrar", "PausaActiva")" class="btn" style="background-color: #76b82a; color: white; border-radius: 8px; font-weight: bold; padding: 8px 20px; margin-right: 10px;">
                + Registrar pausa activa
            </a>

            @* Botón Dashboard (Estilo Azul Oscuro/Cian) *@
        <a href="@Url.Action("Dashboard", "PausaActiva")" class="btn-dashboard">
            <i class="glyphicon glyphicon-stats"></i> Ver Indicadores / Dashboard
        </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th>Cédula</th>
                        <th>Apellidos y Nombre</th>
                        <th>Cargo</th>
                        <th>Proceso</th>
                        <th class="text-center">Fecha Pausa</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No hay registros de pausas activas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@i</td>
                                <td style="font-weight: bold;">@item.Cedula</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Cargo</td>
                                <td>@(item.Proceso != null ? item.Proceso.NombreProceso : "N/A")</td>
                                <td class="text-center">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    @* Cápsula Azul para Ver Detalle *@
                                    <a href="@Url.Action("Detalle", "PausaActiva", new { id = item.IdPausaActiva })"
                                       title="Ver Detalle"
                                       style="display: inline-flex; align-items: center; justify-content: center;
                                       width: 50px; height: 22px; background-color: #76b82a;
                                       border-radius: 50px; color: white; font-size: 11px;
                                       text-decoration: none; font-weight: bold; text-transform: uppercase;">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

