@model ModuloSST_HSLV.Models.ReporteIncidente
@{
    ViewBag.Title = "Registrar Incidente";
    // Usamos tus listas y diccionarios originales
    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso> ?? new List<ModuloSST_HSLV.Models.Proceso>();
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso> ?? new List<ModuloSST_HSLV.Models.Subproceso>();
}

<h2 class="text-primary">Registrar Nuevo Incidente</h2>
<hr />

@using (Html.BeginForm("Registrar", "ReporteIncidente", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdEmpleado)

    @* --- SECCIÓN 1: DATOS DEL INVOLUCRADO --- *@
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Datos del Involucrado</h3></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-2">
                    @Html.LabelFor(m => m.Cedula)
                    @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.NombreCompleto)
                    @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label>Género</label>
                    @Html.DropDownListFor(m => m.Genero, new SelectList(ViewBag.Generos), "-- Seleccionar --", new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.Edad)
                    @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", type = "number" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-4">
                    @Html.LabelFor(m => m.Cargo)
                    @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.Contratista)
                    @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.TiempoPrestacion, "Tiempo de Prestación (meses)")
                    @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-6">
                    <label>Proceso</label>
                    @Html.DropDownListFor(m => m.IdProceso, new SelectList(procesos, "IdProceso", "NombreProceso"), "-- Seleccionar Proceso --", new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    <label>Subproceso / Servicio / Área</label>
                    @Html.DropDownListFor(m => m.IdSubproceso, new SelectList(subprocesos, "IdSubproceso", "NombreSubproceso"), "-- Seleccionar Subproceso --", new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 2: INFORMACIÓN DEL INCIDENTE --- *@
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Información del Incidente</h3></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    @Html.LabelFor(m => m.FechaIncidente)
                    @Html.TextBoxFor(m => m.FechaIncidente, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaIncidente" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.HoraIncidente)
                    @Html.TextBoxFor(m => m.HoraIncidente, "{0:HH\\:mm}", new { @class = "form-control", type = "time" })
                </div>
                <div class="col-md-3">
                    <label>Tipo de Peligro</label>
                    @Html.DropDownListFor(m => m.TipoPeligro, new SelectList(ViewBag.TiposPeligro), "-- Seleccionar --", new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label>Turno</label>
                    @Html.DropDownListFor(m => m.Turno, new SelectList(ViewBag.Turnos), "-- Seleccionar --", new { @class = "form-control" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-8">
                    @Html.LabelFor(m => m.Observaciones)
                    @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "2" })
                </div>
                <div class="col-md-4">
                    <label>Adjuntar PDF del Incidente</label>
                    <input type="file" name="archivoIncidente" accept=".pdf" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 3: INVESTIGACIÓN --- *@
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Investigación y Seguimiento</h3></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    @Html.LabelFor(m => m.FechaInvestigacion)
                    @Html.TextBoxFor(m => m.FechaInvestigacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaInvestigacion" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.DiasInvestigacion)
                    @Html.TextBoxFor(m => m.DiasInvestigacion, new { @class = "form-control", id = "diasInvestigacion", @readonly = "readonly" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-6">
                    <label>Causa</label>
                    <select name="Causa" id="selectCausa" class="form-control">
                        <option value="">-- Seleccionar causa --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label>Subcausa</label>
                    <select name="Subcausa" id="selectSubcausa" class="form-control">
                        <option value="">-- Seleccione primero una causa --</option>
                    </select>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-4">
                    <label>Adjuntar PDF de Investigación</label>
                    <input type="file" name="archivoInvestigacion" accept=".pdf" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 4: PLAN DE MEJORA --- *@
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Plan de Mejora</h3></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-4">
                    @Html.LabelFor(m => m.Responsable)
                    @Html.TextBoxFor(m => m.Responsable, new { @class = "form-control" })
                </div>
                <div class="col-md-8">
                    @Html.LabelFor(m => m.ActividadARealizar)
                    @Html.TextBoxFor(m => m.ActividadARealizar, new { @class = "form-control" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-3">
                    @Html.LabelFor(m => m.FechaPlaneada)
                    @Html.TextBoxFor(m => m.FechaPlaneada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.FechaEjecucion)
                    @Html.TextBoxFor(m => m.FechaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-4">
                    <label>Adjuntar PDF Plan de Mejora</label>
                    <input type="file" name="archivoPlan" accept=".pdf" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 5: OBSERVACIONES FINALES --- *@
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Observaciones Finales</h3></div>
        <div class="panel-body">
            @Html.TextAreaFor(m => m.ObservacionesFinales, new { @class = "form-control", rows = "3" })
        </div>
    </div>

    <div style="margin-bottom: 50px;">
        <button type="submit" class="btn btn-primary btn-lg">Guardar Reporte</button>
        <a href="@Url.Action("Index")" class="btn btn-default btn-lg">Ver listado</a>
    </div>
}

@section Scripts {
    <script>
        // Tu diccionario completo
        var causasSubcausas = {
            'Manejo inadecuado de cortopunzantes': ['Falta de autocuidado', 'Reencapuchar agujas', 'Manejo inseguro durante procedimientos', 'Segregación inadecuada'],
            'Posturas y movimientos inadecuados / ergonomía': ['Posturas inadecuadas', 'Movimientos inadecuados', 'Sobreesfuerzo', 'Levantamiento incorrecto'],
            'Caídas y resbalones': ['Piso húmedo', 'Falta de señalización', 'Desniveles', 'Exceso de confianza'],
            'Movilización inadecuada de pacientes': ['Técnica incorrecta', 'Falta de apoyo', 'No solicitar ayuda'],
            'Factores externos / terceros': ['Acciones inseguras de terceros', 'Pacientes agresivos', 'Bloqueos violentos']
            // ... puedes añadir el resto aquí tal cual lo tenías
        };

        // 1. Llenar el combo de Causas al cargar la página
        var selCausa = document.getElementById('selectCausa');
        for (var c in causasSubcausas) {
            var opt = document.createElement('option');
            opt.value = c; opt.text = c;
            selCausa.appendChild(opt);
        }

        // 2. Lógica de Subcausas
        selCausa.addEventListener('change', function () {
            var selSub = document.getElementById('selectSubcausa');
            selSub.innerHTML = '<option value="">-- Seleccionar subcausa --</option>';
            if (this.value && causasSubcausas[this.value]) {
                causasSubcausas[this.value].forEach(function (sub) {
                    var o = document.createElement('option');
                    o.value = sub; o.text = sub;
                    selSub.appendChild(o);
                });
            }
        });

        // 3. Lógica de cálculo de días
        document.getElementById('fechaInvestigacion').addEventListener('change', function () {
            var fInc = document.getElementById('fechaIncidente').value;
            if (fInc && this.value) {
                var diff = Math.floor((new Date(this.value) - new Date(fInc)) / (1000 * 60 * 60 * 24));
                document.getElementById('diasInvestigacion').value = diff >= 0 ? diff : 0;
            }
        });
    </script>
}