@model ModuloSST_HSLV.Models.ReporteIncidente

@{
    ViewBag.Title = "Registrar Incidente";
    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso> ?? new List<ModuloSST_HSLV.Models.Proceso>();
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso> ?? new List<ModuloSST_HSLV.Models.Subproceso>();
}

<h2 class="text-primary">Registrar Nuevo Incidente</h2>
<hr />

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:15px;">
        <i class="glyphicon glyphicon-exclamation-sign"></i> <strong>Corrija los siguientes errores:</strong>
        <ul style="margin-top:10px;">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@e.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("Registrar", "ReporteIncidente", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdEmpleado)

    @* --- SECCIÓN: DATOS DEL INVOLUCRADO --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-user"></i> 1. Datos del Involucrado
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Cédula</label>
                        @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control", style = "border-radius: 10px;" })
                        @Html.ValidationMessageFor(m => m.Cedula, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label>Nombre Completo</label>
                        @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", style = "border-radius: 10px;" })
                        @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Género</label>
                        @Html.DropDownListFor(m => m.Genero, new SelectList(ViewBag.Generos), "-- Seleccionar --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Edad</label>
                        @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", type = "number", min = "0", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Cargo</label>
                        @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Contratista</label>
                        @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Tiempo de Prestación (meses)</label>
                        @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control", type = "number", min = "0", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Proceso</label>
                        @Html.DropDownListFor(m => m.IdProceso, new SelectList(procesos, "IdProceso", "NombreProceso"), "-- Seleccionar proceso --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subproceso / Servicio / Área</label>
                        @Html.DropDownListFor(m => m.IdSubproceso, new SelectList(subprocesos, "IdSubproceso", "NombreSubproceso"), "-- Seleccionar subproceso --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN: INFORMACIÓN DEL INCIDENTE --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-exclamation-sign"></i> 2. Información del Incidente
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Incidente</label>
                        @Html.TextBoxFor(m => m.FechaIncidente, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaIncidente", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Hora Incidente</label>
                        @Html.TextBoxFor(m => m.HoraIncidente, "{0:HH\\:mm}", new { @class = "form-control", type = "time", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Tipo de Peligro</label>
                        @Html.DropDownListFor(m => m.TipoPeligro, new SelectList(ViewBag.TiposPeligro), "-- Seleccionar --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Turno</label>
                        @Html.DropDownListFor(m => m.Turno, new SelectList(ViewBag.Turnos), "-- Seleccionar --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label>Observaciones</label>
                        @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "3", style = "border-radius: 10px; resize: none;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Adjuntar PDF del Incidente</label>
                        <input type="file" name="archivoIncidente" accept=".pdf" class="form-control" style="border-radius: 10px;" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN: INVESTIGACIÓN Y SEGUIMIENTO --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-search"></i> 3. Investigación y Seguimiento
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Investigación</label>
                        @Html.TextBoxFor(m => m.FechaInvestigacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaInvestigacion", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Días Transcurridos</label>
                        @Html.TextBoxFor(m => m.DiasInvestigacion, new { @class = "form-control", id = "diasInvestigacion", @readonly = "readonly", style = "border-radius: 10px; background-color: #eee;" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>PDF Investigación</label>
                        <input type="file" name="archivoInvestigacion" accept=".pdf" class="form-control" style="border-radius: 10px;" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Causa Principal</label>
                        <select name="Causa" id="selectCausa" class="form-control" style="border-radius: 10px;">
                            <option value="">-- Seleccionar causa --</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subcausa Específica</label>
                        <select name="Subcausa" id="selectSubcausa" class="form-control" style="border-radius: 10px;">
                            <option value="">-- Seleccione primero una causa --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN: PLAN DE MEJORA --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-ok"></i> 4. Plan de Mejora
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Responsable</label>
                        @Html.TextBoxFor(m => m.Responsable, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="form-group">
                        <label>Actividad a Realizar</label>
                        @Html.TextBoxFor(m => m.ActividadARealizar, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Planeada</label>
                        @Html.TextBoxFor(m => m.FechaPlaneada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Ejecución</label>
                        @Html.TextBoxFor(m => m.FechaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Observaciones Finales</label>
                        @Html.TextAreaFor(m => m.ObservacionesFinales, new { @class = "form-control", rows = "2", style = "border-radius: 10px; resize: none;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>PDF Plan de Mejora</label>
                        <input type="file" name="archivoPlan" accept=".pdf" class="form-control" style="border-radius: 10px;" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN DE BOTONES --- *@
    <div style="margin-bottom: 50px; display: flex; gap: 15px; align-items: center;">
        <button type="submit" class="btn-verde-claro" style="padding: 12px 30px; border-radius: 12px; font-weight: bold; border: none; font-size: 15px;">
            <i class="glyphicon glyphicon-floppy-disk"></i> Guardar
        </button>

        <a href="@Url.Action("Index", "ReporteIncidente")"
           class="btn btn-default"
           style="border: 2px solid #29235c; background: transparent; border-radius: 12px; color: #29235c; font-weight: bold; padding: 10px 25px;">
            <i class="glyphicon glyphicon-remove"></i> Cancelar
        </a>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Lógica de Causas y Subcausas
            var causasSubcausas = {
                'Manejo inadecuado de cortopunzantes': [
                    'Falta de autocuidado',
                    'Reencapuchar agujas',
                    'Manejo inseguro durante procedimientos',
                    'Segregación inadecuada'
                ],
                'Posturas y movimientos inadecuados / ergonomía': [
                    'Posturas inadecuadas',
                    'Movimientos inadecuados',
                    'Sobreesfuerzo',
                    'Levantamiento incorrecto'
                ],
                'Caídas y resbalones': [
                    'Piso húmedo',
                    'Falta de señalización',
                    'Desniveles',
                    'Exceso de confianza'
                ],
                'Movilización inadecuada de pacientes': [
                    'Técnica incorrecta',
                    'Falta de apoyo',
                    'No solicitar ayuda'
                ],
                'Factores externos / terceros': [
                    'Acciones inseguras de terceros',
                    'Pacientes agresivos',
                    'Bloqueos violentos'
                ]
            };

            var selCausa = document.getElementById('selectCausa');
            var selSubcausa = document.getElementById('selectSubcausa');

            if (selCausa && selSubcausa) {
                for (var c in causasSubcausas) {
                    var opt = document.createElement('option');
                    opt.value = c;
                    opt.text = c;
                    selCausa.appendChild(opt);
                }

                selCausa.addEventListener('change', function () {
                    selSubcausa.innerHTML = '<option value="">-- Seleccionar subcausa --</option>';

                    if (this.value && causasSubcausas[this.value]) {
                        causasSubcausas[this.value].forEach(function (sub) {
                            var o = document.createElement('option');
                            o.value = sub;
                            o.text = sub;
                            selSubcausa.appendChild(o);
                        });
                    }
                });
            }

            // Cálculo automático de días transcurridos
            var fechaInvestigacion = document.getElementById('fechaInvestigacion');

            if (fechaInvestigacion) {
                fechaInvestigacion.addEventListener('change', function () {
                    var fInc = document.getElementById('fechaIncidente').value;
                    var fInv = this.value;

                    if (fInc && fInv) {
                        var f1 = new Date(fInc);
                        var f2 = new Date(fInv);
                        var diff = Math.floor((f2 - f1) / (1000 * 60 * 60 * 24));

                        document.getElementById('diasInvestigacion').value = diff >= 0 ? diff : 0;
                    }
                });
            }
        });
    </script>
}