@model ModuloSST_HSLV.Models.ReporteIncidente

@{
    ViewBag.Title = "Editar Incidente";
    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso>;
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso>;
    var causas = ViewBag.CausasSubcausas as System.Collections.Generic.Dictionary<string, string[]>;
}

<h2 class="text-primary">Editar Reporte de Incidente</h2>
<p class="text-muted">Modifique la información necesaria del evento registrado.</p>
<hr />

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible" role="alert" style="border-radius: 15px;">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <strong><i class="glyphicon glyphicon-ok"></i></strong> @TempData["Exito"]
    </div>
}

@using (Html.BeginForm("Editar", "ReporteIncidente", FormMethod.Post, new { enctype = "multipart/form-data", id = "formEditar" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdReporteIncidente)
    @Html.HiddenFor(m => m.FechaCreacion)
    @Html.HiddenFor(m => m.IdEmpleado)
    @Html.HiddenFor(m => m.IdProceso)
    @Html.HiddenFor(m => m.IdSubproceso)

    @* --- SECCIÓN 1: DATOS DEL INVOLUCRADO --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-user"></i> 1. Datos del Involucrado
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Cédula</label>
                        @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9; font-weight: bold;" })
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label>Apellidos y Nombre</label>
                        @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9; color: #29235c; font-weight: bold;" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Género</label>
                        @Html.TextBoxFor(m => m.Genero, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9;" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Edad</label>
                        @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Cargo / Función</label>
                        @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Empresa / Contratista</label>
                        @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Tiempo Prestación Meses</label>
                        @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Proceso</label>
                        <input type="text"
                               class="form-control"
                               readonly
                               style="border-radius: 10px; background-color: #f9f9f9;"
                               value="@(Model.Proceso != null ? Model.Proceso.NombreProceso : "—")" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subproceso / Servicio / Área</label>
                        <input type="text"
                               class="form-control"
                               readonly
                               style="border-radius: 10px; background-color: #f9f9f9;"
                               value="@(Model.Subproceso != null ? Model.Subproceso.NombreSubproceso : "—")" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 2: INFORMACIÓN DEL INCIDENTE --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-exclamation-sign"></i> 2. Información del Incidente
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Incidente</label>
                        @Html.TextBoxFor(m => m.FechaIncidente, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Hora Incidente</label>
                        <input type="time"
                               name="HoraIncidente"
                               class="form-control"
                               style="border-radius: 10px;"
                               value="@(Model.HoraIncidente.HasValue ? Model.HoraIncidente.Value.ToString(@"hh\:mm") : "")" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Tipo de Peligro</label>
                        @Html.DropDownListFor(m => m.TipoPeligro, new SelectList(ViewBag.TiposPeligro as string[]), "-- Seleccionar --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Turno</label>
                        @Html.DropDownListFor(m => m.Turno, new SelectList(ViewBag.Turnos as string[]), "-- Seleccionar --", new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label>Relato del Incidente / Observaciones</label>
                        @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "3", style = "border-radius: 10px; resize: none;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Adjuntar / Reemplazar PDF Incidente</label>
                        <input type="file" name="archivoIncidente" accept=".pdf" class="form-control" style="border-radius: 10px;" />

                        @if (!string.IsNullOrEmpty(Model.NombreArchivoIncidente))
                        {
                            <p class="text-muted" style="margin-top: 8px;">
                                Archivo actual: <strong>@Model.NombreArchivoIncidente</strong>
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 3: INVESTIGACIÓN Y ANÁLISIS --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-search"></i> 3. Investigación y Análisis
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Fecha Investigación</label>
                        @Html.TextBoxFor(m => m.FechaInvestigacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaInvestigacion", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Días Investigación</label>
                        @Html.TextBoxFor(m => m.DiasInvestigacion, new { @class = "form-control", id = "diasInvestigacion", @readonly = "readonly", style = "border-radius: 10px; background-color: #eee;" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Adjuntar / Reemplazar PDF Investigación</label>
                        <input type="file" name="archivoInvestigacion" accept=".pdf" class="form-control" style="border-radius: 10px;" />

                        @if (!string.IsNullOrEmpty(Model.NombreArchivoInvestigacion))
                        {
                            <p class="text-muted" style="margin-top: 8px;">
                                Archivo actual: <strong>@Model.NombreArchivoInvestigacion</strong>
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Causa Raíz</label>
                        <select name="Causa" id="selectCausa" class="form-control" style="border-radius: 10px;">
                            <option value="">-- Seleccionar causa --</option>
                            @if (causas != null)
                            {
                                foreach (var c in causas.Keys)
                                {
                                    <option value="@c" @(Model.Causa == c ? "selected" : "")>@c</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subcausa Específica</label>
                        <select name="Subcausa" id="selectSubcausa" class="form-control" style="border-radius: 10px;">
                            <option value="">-- Seleccione primero una causa --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 4: PLAN DE MEJORA --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-ok"></i> 4. Plan de Mejora
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Responsable</label>
                        @Html.TextBoxFor(m => m.Responsable, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="form-group">
                        <label>Intervención / Actividad</label>
                        @Html.TextBoxFor(m => m.ActividadARealizar, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Planeada</label>
                        @Html.TextBoxFor(m => m.FechaPlaneada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha Ejecución</label>
                        @Html.TextBoxFor(m => m.FechaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Adjuntar / Reemplazar Soporte Plan de Mejora PDF</label>
                        <input type="file" name="archivoPlan" accept=".pdf" class="form-control" style="border-radius: 10px;" />

                        @if (!string.IsNullOrEmpty(Model.NombreArchivoPlan))
                        {
                            <p class="text-muted" style="margin-top: 8px;">
                                Archivo actual: <strong>@Model.NombreArchivoPlan</strong>
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Observaciones Finales / Cierre</label>
                        @Html.TextAreaFor(m => m.ObservacionesFinales, new { @class = "form-control", rows = "2", style = "border-radius: 10px; resize: none;" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN DE BOTONES --- *@
    <div style="margin-bottom: 50px; display: flex; gap: 15px; align-items: center;">
        <button type="submit" class="btn-verde-claro" style="padding: 12px 30px; border-radius: 12px; font-weight: bold; border: none; font-size: 15px;">
            <i class="glyphicon glyphicon-floppy-disk"></i> Actualizar Reporte
        </button>

        <a href="@Url.Action("Index", "ReporteIncidente")"
           class="btn btn-default"
           style="border: 2px solid #29235c; background: transparent; border-radius: 12px; color: #29235c; font-weight: bold; padding: 10px 25px;">
            <i class="glyphicon glyphicon-remove"></i> Cancelar
        </a>
    </div>
}

@section Scripts {
    <script>
        var causasSubcausas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(causas));

        function cargarSubcausas(causaSeleccionada, subcausaGuardada) {
            var sel = document.getElementById('selectSubcausa');
            sel.innerHTML = '<option value="">-- Seleccionar subcausa --</option>';

            if (causaSeleccionada && causasSubcausas[causaSeleccionada]) {
                causasSubcausas[causaSeleccionada].forEach(function (sub) {
                    var o = document.createElement('option');
                    o.value = sub;
                    o.text = sub;

                    if (sub === subcausaGuardada) {
                        o.selected = true;
                    }

                    sel.appendChild(o);
                });
            }
        }

        window.onload = function () {
            var causaIni = document.getElementById('selectCausa').value;
            cargarSubcausas(causaIni, '@Html.Raw(Model.Subcausa)');
        };

        document.getElementById('selectCausa').addEventListener('change', function () {
            cargarSubcausas(this.value, '');
        });

        document.getElementById('fechaInvestigacion').addEventListener('change', function () {
            var fIncVal = document.querySelector('[name="FechaIncidente"]').value;

            if (fIncVal && this.value) {
                var fIncidente = new Date(fIncVal);
                var fInvestigacion = new Date(this.value);
                var diff = (fInvestigacion - fIncidente) / (1000 * 60 * 60 * 24);

                document.getElementById('diasInvestigacion').value = Math.max(0, Math.round(diff));
            }
        });
    </script>
}

<style>
    .btn-verde-claro {
        background-color: #76b82a;
        color: white;
    }

        .btn-verde-claro:hover {
            background-color: #5f9821;
            color: white;
        }
</style>