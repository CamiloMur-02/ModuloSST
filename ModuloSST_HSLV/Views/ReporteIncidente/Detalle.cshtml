@model ModuloSST_HSLV.Models.ReporteIncidente
@{ ViewBag.Title = "Detalle — Incidente"; }
<h2 class="text-primary">Detalle — Reporte de Incidente</h2>
<hr />
<div class="panel panel-default">
    <div class="panel-heading"><h3 class="panel-title">Datos del Involucrado</h3></div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-2"><strong>Cédula:</strong><br />@Model.Cedula</div>
            <div class="col-md-4"><strong>Apellidos y Nombre:</strong><br />@Model.NombreCompleto</div>
            <div class="col-md-2"><strong>Género:</strong><br />@Model.Genero</div>
            <div class="col-md-2"><strong>Edad:</strong><br />@Model.Edad años</div>
        </div>
        <div class="row" style="margin-top:10px">
            <div class="col-md-4"><strong>Cargo:</strong><br />@Model.Cargo</div>
            <div class="col-md-4"><strong>Contratista:</strong><br />@Model.Contratista</div>
            <div class="col-md-4"><strong>Tiempo de Prestación:</strong><br />@Model.TiempoPrestacion</div>
        </div>
        <div class="row" style="margin-top:10px">
            <div class="col-md-6">
                <strong>Proceso:</strong><br />
                @(Model.Proceso != null ? Model.Proceso.NombreProceso : Model.IdProceso.ToString())
            </div>
            <div class="col-md-6">
                <strong>Subproceso:</strong><br />
                @(Model.Subproceso != null ? Model.Subproceso.NombreSubproceso : Model.IdSubproceso.ToString())
            </div>
        </div>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-heading"><h3 class="panel-title">Información del Incidente</h3></div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-3"><strong>Fecha:</strong><br />@Model.FechaIncidente.ToString("dd/MM/yyyy")</div>
            <div class="col-md-3">
                <strong>Hora:</strong><br />
                @(Model.HoraIncidente.HasValue ? Model.HoraIncidente.Value.ToString(@"hh\:mm") : "—")
            </div>
            <div class="col-md-3"><strong>Tipo de Peligro:</strong><br />@Model.TipoPeligro</div>
            <div class="col-md-3"><strong>Turno:</strong><br />@(Model.Turno ?? "—")</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Observaciones))
        {
            <div class="row" style="margin-top:10px">
                <div class="col-md-12"><strong>Observaciones:</strong><br />@Model.Observaciones</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.NombreArchivoIncidente))
        {
            <div class="row" style="margin-top:10px">
                <div class="col-md-12">
                    <strong>PDF Incidente:</strong>
                    <a href="@Url.Action("Descargar", "ReporteIncidente",
                        new { ruta = Model.RutaArchivoIncidente, nombre = Model.NombreArchivoIncidente })"
                       class="btn btn-sm btn-success">
                        @Model.NombreArchivoIncidente
                    </a>
                </div>
            </div>
        }
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.Causa))
{
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Investigación y Seguimiento</h3></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    <strong>Fecha Investigación:</strong><br />
                    @(Model.FechaInvestigacion.HasValue ? Model.FechaInvestigacion.Value.ToString("dd/MM/yyyy") : "—")
                </div>
                <div class="col-md-2"><strong>Días Inv.:</strong><br />@(Model.DiasInvestigacion ?? 0)</div>
                <div class="col-md-4"><strong>Causa:</strong><br />@Model.Causa</div>
                <div class="col-md-3"><strong>Subcausa:</strong><br />@(Model.Subcausa ?? "—")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.NombreArchivoInvestigacion))
            {
                <div class="row" style="margin-top:10px">
                    <div class="col-md-12">
                        <strong>PDF Investigación:</strong>
                        <a href="@Url.Action("Descargar", "ReporteIncidente",
                            new { ruta = Model.RutaArchivoInvestigacion, nombre = Model.NombreArchivoInvestigacion })"
                           class="btn btn-sm btn-success">
                            @Model.NombreArchivoInvestigacion
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Responsable))
{
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Plan de Mejora</h3></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-4"><strong>Responsable:</strong><br />@Model.Responsable</div>
                <div class="col-md-8"><strong>Actividad:</strong><br />@(Model.ActividadARealizar ?? "—")</div>
            </div>
            <div class="row" style="margin-top:10px">
                <div class="col-md-3">
                    <strong>Fecha Planeada:</strong><br />
                    @(Model.FechaPlaneada.HasValue ? Model.FechaPlaneada.Value.ToString("dd/MM/yyyy") : "—")
                </div>
                <div class="col-md-3">
                    <strong>Fecha Ejecución:</strong><br />
                    @(Model.FechaEjecucion.HasValue ? Model.FechaEjecucion.Value.ToString("dd/MM/yyyy") : "—")
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.NombreArchivoPlan))
            {
                <div class="row" style="margin-top:10px">
                    <div class="col-md-12">
                        <strong>PDF Plan:</strong>
                        <a href="@Url.Action("Descargar", "ReporteIncidente",
                            new { ruta = Model.RutaArchivoPlan, nombre = Model.NombreArchivoPlan })"
                           class="btn btn-sm btn-success">
                            @Model.NombreArchivoPlan
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ObservacionesFinales))
{
    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Observaciones Finales</h3></div>
        <div class="panel-body">@Model.ObservacionesFinales</div>
    </div>
}
<a href="@Url.Action("Index", "ReporteIncidente")"
   class="btn btn-default" style="border:2px solid #aaa;background:transparent;">
    Ver listado
</a>
<a href="@Url.Action("Editar", "ReporteIncidente", new { id = Model.IdReporteIncidente })"
   class="btn btn-warning" style="margin-left:5px">
    Editar
</a>