@model IEnumerable<ModuloSST_HSLV.Models.MatrizEpp>
@{ ViewBag.Title = "Matriz de Entrega de EPP"; }
<div class="row">
    <div class="col-md-12">
        <h2 class="text-primary">Matriz de Entrega de EPP</h2>
        <hr />
        <p>
            @Html.ActionLink("+ Registrar entrega", "Registrar", "MatrizEpp", null, new { @class = "btn btn-primary" })
            <a href="@Url.Action("Index", "CatalogoEpp")" class="btn btn-default" style="border:2px solid #aaa;background:transparent;">
                Catálogo EPP
            </a>
        </p>
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr class="active">
                        <th>#</th>
                        <th>Cédula</th>
                        <th>Apellidos y Nombres</th>
                        <th>Cargo</th>
                        <th>Proceso</th>
                        <th>Subproceso</th>
                        <th>Fecha Registro</th>
                        <th>EPP Activos</th>
                        <th>Alertas</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted">No hay registros de entrega de EPP.</td></tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            int alertas = item.Elementos.Count(e => e.Activo && e.TiempoRestante <= 0);
                            <tr>
                                <td>@i</td>
                                <td>@item.Cedula</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Cargo</td>
                                <td>@(item.Proceso != null ? item.Proceso.NombreProceso : item.IdProceso.ToString())</td>
                                <td>@(item.Subproceso != null ? item.Subproceso.NombreSubproceso : item.IdSubproceso.ToString())</td>
                                <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">@item.Elementos.Count(e => e.Activo)</td>
                                <td class="text-center">
                                    @if (alertas > 0)
                                    {
                                        <span class="badge bg-danger">@alertas vencido(s)</span>
                                    }
                                    else
                                    {
                                        <span>OK</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Editar", "MatrizEpp", new { id = item.IdMatrizEPP })"
                                       class="btn btn-sm btn-warning">Editar</a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>