@model IEnumerable<ModuloSST_HSLV.Models.MatrizEpp>
@{
    ViewBag.Title = "Matriz de Entrega de EPP";
}

<div class="row">
    <div class="col-md-12">
        <h2 class="text-primary">Matriz de Entrega de EPP</h2>
        <hr />

        <p>
            @Html.ActionLink("+ Registrar entrega", "Registrar", "MatrizEpp", null, new { @class = "btn-verde-claro" })

            <a href="@Url.Action("Index", "CatalogoEpp")" class="btn btn-default"
               style="border: 2px solid #29235c; color: #29235c; border-radius: 12px; font-weight: 600; margin-left: 5px; padding: 8px 15px;">
                Catálogo EPP
            </a>

            <a href="@Url.Action("Dashboard", "MatrizEpp")" class="btn-dashboard" style="margin-left: 5px;">
                <i class="glyphicon glyphicon-stats"></i> Ver Estadísticas de Suministros
            </a>
        </p>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th>Cédula</th>
                        <th>Apellidos y Nombres</th>
                        <th>Cargo</th>
                        <th>Proceso / Área</th>
                        <th class="text-center">Fecha Registro</th>
                        <th class="text-center">EPP Activos</th>
                        <th class="text-center">Alertas / Estado</th>
                        <th class="text-center" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted">No hay registros de entrega de EPP.</td></tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            
                            var elementosLista = item.Elementos as IEnumerable<dynamic>;
                            var activos = elementosLista != null ? elementosLista.Where(e => e.Activo).ToList() : new List<dynamic>();

                            int vencidos = activos.Count(e => e.TiempoRestante <= 0);
                            int porVencer = activos.Count(e => e.TiempoRestante > 0 && e.TiempoRestante <= 1);
                            int totalActivos = activos.Count;

                            <tr>
                                <td class="text-center">@i</td>
                                <td style="font-weight:bold">@item.Cedula</td>
                                <td>@item.NombreCompleto</td>
                                <td><small>@item.Cargo</small></td>
                                <td>
                                    <small class="text-muted">
                                        @(item.Proceso != null ? item.Proceso.NombreProceso : "N/A")
                                    </small>
                                </td>
                                <td class="text-center">@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span style="background:#e8ecef; padding: 2px 10px; border-radius: 10px; font-weight: bold; color: #29235c;">
                                        @totalActivos
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (vencidos > 0)
                                    {
                                        <span style="background-color: #dc3545; color: white; padding: 4px 8px; border-radius: 8px; font-size: 10px; display: block; margin-bottom: 2px; font-weight: bold;">
                                            <i class="glyphicon glyphicon-remove-sign"></i> @vencidos VENCIDOS
                                        </span>
                                    }

                                    @if (porVencer > 0)
                                    {
                                        <span style="background-color: #ffc107; color: #212529; padding: 4px 8px; border-radius: 8px; font-size: 10px; display: block; font-weight: bold;">
                                            <i class="glyphicon glyphicon-warning-sign"></i> @porVencer POR VENCER
                                        </span>
                                    }

                                    @if (vencidos == 0 && porVencer == 0 && totalActivos > 0)
                                    {
                                        <span style="background-color: #76b82a; color: white; padding: 4px 10px; border-radius: 8px; font-size: 10px; font-weight: bold;">
                                            <i class="glyphicon glyphicon-ok"></i> AL DÍA
                                        </span>
                                    }
                                    else if (totalActivos == 0)
                                    {
                                        <span class="text-muted small"><i>Sin EPP</i></span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Editar", "MatrizEpp", new { id = item.IdMatrizEPP })"
                                       class="btn-ver" style="text-decoration: none; display: inline-block;">
                                        Gestionar
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>