@model ModuloSST_HSLV.Models.ReporteAccidenteTrabajo
@{
    ViewBag.Title = "Registrar Accidente de Trabajo";
    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso>;
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso>;

    // Obtenemos el diccionario del ViewBag
    var causasDict = ViewBag.CausasSubcausas as System.Collections.Generic.Dictionary<string, string[]>;
}

<h2 class="text-primary">Registrar Accidente de Trabajo</h2>
<hr />

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Corrija los siguientes errores antes de guardar:</strong>
        <ul>
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@e.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("Registrar", "ReporteAccidenteTrabajo", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdEmpleado)

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Datos del Accidentado</h3>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Cedula)
                        @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Cedula, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.LabelFor(m => m.NombreCompleto)
                        @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Genero)
                        <select name="Genero" class="form-control">
                            <option value="">-- Género --</option>
                            @foreach (var g in ViewBag.Generos as string[])
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Edad)
                        @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Cargo)
                        @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Cargo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Contratista)
                        @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.LabelFor(m => m.TiempoPrestacion)
                        @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Proceso</label>
                        <select name="IdProceso" class="form-control">
                            <option value="">-- Seleccionar proceso --</option>
                            @foreach (var p in procesos)
                            {
                                <option value="@p.IdProceso">@p.NombreProceso</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subproceso / Servicio / Área</label>
                        <select name="IdSubproceso" class="form-control">
                            <option value="">-- Seleccionar subproceso --</option>
                            @foreach (var s in subprocesos)
                            {
                                <option value="@s.IdSubproceso">@s.NombreSubproceso</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Información del Accidente</h3>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.NumeroReporte)
                        @Html.TextBoxFor(m => m.NumeroReporte, new { @class = "form-control", type = "number" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FechaAT)
                        @Html.TextBoxFor(m => m.FechaAT, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.HoraAT)
                        @Html.TextBoxFor(m => m.HoraAT, "{0:HH\\:mm}", new { @class = "form-control", type = "time" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Tipo de Peligro</label>
                        <select name="TipoPeligro" class="form-control">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var t in ViewBag.TiposPeligro as string[])
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.DiasIncapacidad)
                        @Html.TextBoxFor(m => m.DiasIncapacidad, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.CodigoDiagnostico)
                        @Html.TextBoxFor(m => m.CodigoDiagnostico, new { @class = "form-control", placeholder = "Ej: W46" })
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        @Html.LabelFor(m => m.DetalleDiagnostico)
                        @Html.TextBoxFor(m => m.DetalleDiagnostico, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FechaReporte)
                        @Html.TextBoxFor(m => m.FechaReporte, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ObservacionesAccidente)
                        @Html.TextAreaFor(m => m.ObservacionesAccidente, new { @class = "form-control", rows = "2" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Adjuntar Furat (PDF)</label>
                        <input type="file" name="archivoAccidente" accept=".pdf" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Investigación y Seguimiento</h3>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FechaInvestigacion)
                        @Html.TextBoxFor(m => m.FechaInvestigacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "fechaInvestigacion" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.LabelFor(m => m.DiasInvestigacion)
                        @Html.TextBoxFor(m => m.DiasInvestigacion, new { @class = "form-control", id = "diasInvestigacion", @readonly = "readonly" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Turno</label>
                        <select name="Turno" class="form-control">
                            <option value="">-- Turno --</option>
                            @foreach (var t in ViewBag.Turnos as string[])
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Causa</label>
                        <select name="Causa" id="selectCausa" class="form-control">
                            <option value="">-- Seleccionar causa --</option>
                            @if (causasDict != null)
                            {
                                foreach (var c in causasDict.Keys)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                        <span class="help-block text-muted">Si la causa no está en la lista, descríbala en Observaciones Finales.</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subcausa</label>
                        <select name="Subcausa" id="selectSubcausa" class="form-control">
                            <option value="">-- Seleccione primero una causa --</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Adjuntar PDF de Investigación</label>
                        <input type="file" name="archivoInvestigacion" accept=".pdf" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Plan de Mejora</h3>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Responsable)
                        @Html.TextBoxFor(m => m.Responsable, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-group">
                        @Html.LabelFor(m => m.IntervencionRealizar)
                        @Html.TextBoxFor(m => m.IntervencionRealizar, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FechaPlaneada)
                        @Html.TextBoxFor(m => m.FechaPlaneada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FechaEjecucion)
                        @Html.TextBoxFor(m => m.FechaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Adjuntar PDF Plan de Mejora</label>
                        <input type="file" name="archivoPlan" accept=".pdf" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Observaciones Finales</h3>
        </div>
        <div class="panel-body">
            <div class="form-group">
                @Html.LabelFor(m => m.ObservacionesFinales)
                @Html.TextAreaFor(m => m.ObservacionesFinales, new { @class = "form-control", rows = "3" })
            </div>
        </div>
    </div>

    <div class="form-group" style="margin-bottom: 50px;">
        <button type="submit" class="btn btn-primary btn-lg">Guardar Reporte</button>
        <a href="@Url.Action("Index", "ReporteAccidenteTrabajo")" class="btn btn-default btn-lg" style="border:1px solid #ccc;">
            Cancelar e ir al Listado
        </a>
    </div>
}

@section Scripts {
    <script>
        // 1. Inyectamos el diccionario del ViewBag a JavaScript de forma segura
        var causasSubcausas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CausasSubcausas));

        // 2. Lógica para filtrar subcausas
        document.getElementById('selectCausa').addEventListener('change', function () {
            var causaSeleccionada = this.value;
            var subcausaSelect = document.getElementById('selectSubcausa');

            // Limpiar opciones anteriores
            subcausaSelect.innerHTML = '<option value="">-- Seleccionar subcausa --</option>';

            if (causaSeleccionada && causasSubcausas[causaSeleccionada]) {
                causasSubcausas[causaSeleccionada].forEach(function (sub) {
                    var option = document.createElement('option');
                    option.value = sub;
                    option.text = sub;
                    subcausaSelect.appendChild(option);
                });
            }
        });

        // 3. Cálculo automático de días de investigación
        document.getElementById('fechaInvestigacion').addEventListener('change', function () {
            var fechaAccidenteInput = document.querySelector('[name="FechaAT"]');
            var fechaInvestigacion = this.value;

            if (fechaAccidenteInput && fechaAccidenteInput.value && fechaInvestigacion) {
                var fInicio = new Date(fechaAccidenteInput.value);
                var fFin = new Date(fechaInvestigacion);

                // Calculamos la diferencia en milisegundos y pasamos a días
                var diff = (fFin - fInicio) / (1000 * 60 * 60 * 24);
                document.getElementById('diasInvestigacion').value = Math.max(0, Math.round(diff));
            }
        });
    </script>
}