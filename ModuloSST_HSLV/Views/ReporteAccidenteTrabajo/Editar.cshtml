@model ModuloSST_HSLV.Models.ReporteAccidenteTrabajo

@{
    ViewBag.Title = "Editar Accidente de Trabajo";

    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso>;
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso>;
    var causas = ViewBag.CausasSubcausas as Dictionary<string, string[]>;

    var listaGeneros = (ViewBag.Generos as string[] ?? new string[0])
        .Select(g => new SelectListItem { Value = g, Text = g, Selected = (Model.Genero == g) })
        .ToList();

    var listaTiposPeligro = (ViewBag.TiposPeligro as string[] ?? new string[0])
        .Select(t => new SelectListItem { Value = t, Text = t, Selected = (Model.TipoPeligro == t) })
        .ToList();

    var listaTurnos = (ViewBag.Turnos as string[] ?? new string[0])
        .Select(t => new SelectListItem { Value = t, Text = t, Selected = (Model.Turno == t) })
        .ToList();

    var listaProcesos = (procesos ?? new List<ModuloSST_HSLV.Models.Proceso>())
        .Select(p => new SelectListItem { Value = p.IdProceso.ToString(), Text = p.NombreProceso, Selected = (Model.IdProceso == p.IdProceso) })
        .ToList();

    var listaSubprocesos = (subprocesos ?? new List<ModuloSST_HSLV.Models.Subproceso>())
        .Select(s => new SelectListItem { Value = s.IdSubproceso.ToString(), Text = s.NombreSubproceso, Selected = (Model.IdSubproceso == s.IdSubproceso) })
        .ToList();

    var listaCausas = causas != null
        ? causas.Keys.Select(c => new SelectListItem { Value = c, Text = c, Selected = (Model.Causa == c) }).ToList()
        : new List<SelectListItem>();
}

<div class="container-fluid page-wrapper">

    @* --- CABECERA --- *@
    <div class="row">
        <div class="col-md-8">
            <h2 class="page-title">
                <i class="glyphicon glyphicon-edit icon-accent"></i>
                Editar Reporte de Accidente de Trabajo
            </h2>
        </div>
    </div>

    <hr class="separator" />

    @* --- RESUMEN DE ERRORES --- *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-custom">
            <i class="glyphicon glyphicon-exclamation-sign"></i>
            <strong>Corrija los siguientes errores:</strong>
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        </div>
    }

    @using (Html.BeginForm(
        "Editar",
        "ReporteAccidenteTrabajo",
        FormMethod.Post,
        new { enctype = "multipart/form-data", id = "formEditar" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdReporteAccidenteTrabajo)
        @Html.HiddenFor(m => m.IdEmpleado)
        @Html.HiddenFor(m => m.FechaCreacion)
        @Html.HiddenFor(m => m.NombreArchivoAccidente)
        @Html.HiddenFor(m => m.RutaArchivoAccidente)
        @Html.HiddenFor(m => m.NombreArchivoInvestigacion)
        @Html.HiddenFor(m => m.RutaArchivoInvestigacion)
        @Html.HiddenFor(m => m.NombreArchivoPlan)
        @Html.HiddenFor(m => m.RutaArchivoPlan)

        @* ===================================================== *@
        @* --- SECCIÓN 1: INFORMACIÓN DEL ACCIDENTADO --- *@
        @* ===================================================== *@

        <div class="panel panel-seccion">

            <div class="panel-heading panel-heading-primario">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-user"></i>
                    1. Información del Accidentado
                </h3>
            </div>

            <div class="panel-body panel-body-custom">

                @* --- FILA 1 --- *@
                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="Cedula" class="label-form">Cédula</label>
                            @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control input-custom" })
                            @Html.ValidationMessageFor(m => m.Cedula, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-group">
                            <label for="NombreCompleto" class="label-form">Nombre Completo</label>
                            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control input-custom" })
                            @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="Genero" class="label-form">Género</label>
                            @Html.DropDownListFor(m => m.Genero,
                                listaGeneros,
                                "-- Género --",
                                new { @class = "form-control input-custom" })
                            @Html.ValidationMessageFor(m => m.Genero, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="Edad" class="label-form">Edad</label>
                            @Html.TextBoxFor(m => m.Edad, new
                            {
                                @class = "form-control input-custom",
                                type = "number",
                                min = "0"
                            })
                        </div>
                    </div>

                </div>

                @* --- FILA 2 --- *@
                <div class="row">

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="Cargo" class="label-form">Cargo</label>
                            @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="Contratista" class="label-form">Contratista</label>
                            @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="TiempoPrestacion" class="label-form">Tiempo Prestación (meses)</label>
                            @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control input-custom" })
                        </div>
                    </div>

                </div>

                @* --- FILA 3 --- *@
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="IdProceso" class="label-form">Proceso</label>
                            @Html.DropDownListFor(m => m.IdProceso,
                                listaProcesos,
                                "-- Seleccionar Proceso --",
                                new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="IdSubproceso" class="label-form">Subproceso</label>
                            @Html.DropDownListFor(m => m.IdSubproceso,
                                listaSubprocesos,
                                "-- Seleccionar Subproceso --",
                                new { @class = "form-control input-custom" })
                        </div>
                    </div>

                </div>

            </div>

        </div>

        @* ===================================================== *@
        @* --- SECCIÓN 2: INFORMACIÓN DEL ACCIDENTE --- *@
        @* ===================================================== *@

        <div class="panel panel-seccion">

            <div class="panel-heading panel-heading-secundario">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-exclamation-sign"></i>
                    2. Información del Accidente
                </h3>
            </div>

            <div class="panel-body panel-body-custom">

                <div class="row">

                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="NumeroReporte" class="label-form">Número Reporte</label>
                            @Html.TextBoxFor(m => m.NumeroReporte, new
                            {
                                @class = "form-control input-custom",
                                type = "number",
                                min = "0"
                            })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="FechaAT" class="label-form">Fecha del Accidente</label>
                            @Html.TextBoxFor(m => m.FechaAT, "{0:yyyy-MM-dd}", new
                            {
                                @class = "form-control input-custom",
                                type = "date",
                                id = "fechaAT"
                            })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="HoraAT" class="label-form">Hora del Accidente</label>
                            @Html.TextBoxFor(m => m.HoraAT, "{0:hh\\:mm}", new
                            {
                                @class = "form-control input-custom",
                                type = "time"
                            })
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="TipoPeligro" class="label-form">Tipo Peligro</label>
                            @Html.DropDownListFor(m => m.TipoPeligro,
                                listaTiposPeligro,
                                "-- Seleccionar --",
                                new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="DiasIncapacidad" class="label-form">Días de Incapacidad</label>
                            @Html.TextBoxFor(m => m.DiasIncapacidad, new
                            {
                                @class = "form-control input-custom",
                                type = "number",
                                min = "0"
                            })
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="CodigoDiagnostico" class="label-form">Código del Diagnóstico</label>
                            @Html.TextBoxFor(m => m.CodigoDiagnostico, new
                            {
                                @class = "form-control input-custom",
                                placeholder = "Ej: W46"
                            })
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-group">
                            <label for="DetalleDiagnostico" class="label-form">Detalle del Diagnóstico</label>
                            @Html.TextBoxFor(m => m.DetalleDiagnostico, new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="FechaReporte" class="label-form">Fecha de Reporte</label>
                            @Html.TextBoxFor(m => m.FechaReporte, "{0:yyyy-MM-dd}", new
                            {
                                @class = "form-control input-custom",
                                type = "date"
                            })
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-8">
                        <div class="form-group">
                            <label for="ObservacionesAccidente" class="label-form">Observaciones</label>
                            @Html.TextAreaFor(m => m.ObservacionesAccidente, new
                            {
                                @class = "form-control textarea-custom",
                                rows = "4"
                            })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="archivoAccidente" class="label-form">Adjuntar / Reemplazar FURAT PDF</label>
                            <input type="file"
                                   id="archivoAccidente"
                                   name="archivoAccidente"
                                   accept=".pdf"
                                   class="form-control input-custom" />
                            @if (!string.IsNullOrEmpty(Model.NombreArchivoAccidente))
                            {
                                <p class="archivo-actual">
                                    Archivo actual: <strong>@Model.NombreArchivoAccidente</strong>
                                </p>
                            }
                        </div>
                    </div>

                </div>

            </div>

        </div>

        @* ===================================================== *@
        @* --- SECCIÓN 3: INVESTIGACIÓN Y SEGUIMIENTO --- *@
        @* ===================================================== *@

        <div class="panel panel-seccion">

            <div class="panel-heading panel-heading-primario">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-search"></i>
                    3. Investigación y Seguimiento
                </h3>
            </div>

            <div class="panel-body panel-body-custom">

                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="FechaInvestigacion" class="label-form">Fecha Investigación</label>
                            @Html.TextBoxFor(m => m.FechaInvestigacion, "{0:yyyy-MM-dd}", new
                            {
                                @class = "form-control input-custom",
                                type = "date",
                                id = "fechaInvestigacion"
                            })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="DiasInvestigacion" class="label-form">Días Investigación</label>
                            @Html.TextBoxFor(m => m.DiasInvestigacion, new
                            {
                                @class = "form-control input-custom input-readonly",
                                id = "diasInvestigacion",
                                @readonly = "readonly"
                            })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="Turno" class="label-form">Turno</label>
                            @Html.DropDownListFor(m => m.Turno,
                                listaTurnos,
                                "-- Seleccionar --",
                                new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="archivoInvestigacion" class="label-form">Adjuntar / Reemplazar Investigación PDF</label>
                            <input type="file"
                                   id="archivoInvestigacion"
                                   name="archivoInvestigacion"
                                   accept=".pdf"
                                   class="form-control input-custom" />
                            @if (!string.IsNullOrEmpty(Model.NombreArchivoInvestigacion))
                            {
                                <p class="archivo-actual">
                                    Archivo actual: <strong>@Model.NombreArchivoInvestigacion</strong>
                                </p>
                            }
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="selectCausa" class="label-form">Causa Principal</label>
                            @Html.DropDownListFor(m => m.Causa,
                                listaCausas,
                                "-- Seleccionar causa --",
                                new { @class = "form-control input-custom", id = "selectCausa" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="selectSubcausa" class="label-form">Subcausa Específica</label>
                            <select name="Subcausa"
                                    id="selectSubcausa"
                                    class="form-control input-custom">
                                <option value="">-- Seleccione primero una causa --</option>
                            </select>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        @* ===================================================== *@
        @* --- SECCIÓN 4: PLAN DE MEJORA --- *@
        @* ===================================================== *@

        <div class="panel panel-seccion">

            <div class="panel-heading panel-heading-secundario">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-ok"></i>
                    4. Plan de Mejora
                </h3>
            </div>

            <div class="panel-body panel-body-custom">

                <div class="row">

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="Responsable" class="label-form">Responsable</label>
                            @Html.TextBoxFor(m => m.Responsable, new { @class = "form-control input-custom" })
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="form-group">
                            <label for="IntervencionRealizar" class="label-form">Intervención a Realizar</label>
                            @Html.TextBoxFor(m => m.IntervencionRealizar, new { @class = "form-control input-custom" })
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="FechaPlaneada" class="label-form">Fecha Planeada</label>
                            @Html.TextBoxFor(m => m.FechaPlaneada, "{0:yyyy-MM-dd}", new
                            {
                                @class = "form-control input-custom",
                                type = "date"
                            })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="FechaEjecucion" class="label-form">Fecha Ejecución</label>
                            @Html.TextBoxFor(m => m.FechaEjecucion, "{0:yyyy-MM-dd}", new
                            {
                                @class = "form-control input-custom",
                                type = "date"
                            })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="archivoPlan" class="label-form">Adjuntar / Reemplazar Plan de Mejora PDF</label>
                            <input type="file"
                                   id="archivoPlan"
                                   name="archivoPlan"
                                   accept=".pdf"
                                   class="form-control input-custom" />
                            @if (!string.IsNullOrEmpty(Model.NombreArchivoPlan))
                            {
                                <p class="archivo-actual">
                                    Archivo actual: <strong>@Model.NombreArchivoPlan</strong>
                                </p>
                            }
                        </div>
                    </div>

                </div>

            </div>

        </div>

        @* ===================================================== *@
        @* --- SECCIÓN 5: OBSERVACIONES GENERALES --- *@
        @* ===================================================== *@

        <div class="panel panel-seccion">

            <div class="panel-heading panel-heading-alerta">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-comment"></i>
                    5. Observaciones Generales
                </h3>
            </div>

            <div class="panel-body panel-body-custom">

                <div class="form-group" style="margin-bottom: 0;">
                    <label for="ObservacionesFinales" class="label-form">Observaciones Finales</label>
                    @Html.TextAreaFor(m => m.ObservacionesFinales, new
                    {
                        @class = "form-control textarea-custom",
                        rows = "4"
                    })
                </div>

            </div>

        </div>

        @* ===================================================== *@
        @* --- BOTONES --- *@
        @* ===================================================== *@

        <div class="botones-wrapper">

            <button type="submit" class="btn btn-success btn-lg btn-guardar-custom">
                <i class="glyphicon glyphicon-floppy-disk"></i>
                Actualizar
            </button>

            <a href="@Url.Action("Index", "ReporteAccidenteTrabajo")"
               class="btn btn-default btn-cancelar-custom">
                <i class="glyphicon glyphicon-remove"></i>
                Cancelar
            </a>

        </div>
    }

</div>

@section Scripts {

    <script>

        // Datos inyectados desde el servidor
        var causasSubcausas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(causas ?? new Dictionary<string, string[]>()));
        var subcausaActual  = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Subcausa ?? ""))';

        // Carga las subcausas del select según la causa seleccionada
        function cargarSubcausas(causaSeleccionada, subcausaPreseleccionada) {

            var selSubcausa = document.getElementById('selectSubcausa');
            selSubcausa.innerHTML = '<option value="">-- Seleccionar subcausa --</option>';

            if (!causaSeleccionada || !causasSubcausas[causaSeleccionada]) return;

            causasSubcausas[causaSeleccionada].forEach(function (sub) {

                var option    = document.createElement('option');
                option.value  = sub;
                option.text   = sub;

                if (subcausaPreseleccionada && sub === subcausaPreseleccionada) {
                    option.selected = true;
                }

                selSubcausa.appendChild(option);
            });
        }

        // Calcula días entre fecha accidente y fecha investigación
        function calcularDiasInvestigacion(fAccidente, fInvestigacion) {

            var f1   = new Date(fAccidente);
            var f2   = new Date(fInvestigacion);
            var diff = Math.floor((f2 - f1) / (1000 * 60 * 60 * 24));

            var campoDias   = document.getElementById('diasInvestigacion');
            var alertaFecha = document.getElementById('alertaFechaInvestigacion');

            if (diff < 0) {
                campoDias.value       = 0;
                alertaFecha.style.display = 'block';
            } else {
                campoDias.value           = diff;
                alertaFecha.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {

            var selCausa          = document.getElementById('selectCausa');
            var fechaInvestigacion = document.getElementById('fechaInvestigacion');

            // Precargar subcausas con el valor guardado
            if (selCausa) {
                cargarSubcausas(selCausa.value, subcausaActual);

                selCausa.addEventListener('change', function () {
                    cargarSubcausas(this.value, null);
                });
            }

            // Calcular días al cambiar la fecha de investigación
            if (fechaInvestigacion) {
                fechaInvestigacion.addEventListener('change', function () {

                    var fAccidente = document.getElementById('fechaAT').value;

                    if (fAccidente && this.value) {
                        calcularDiasInvestigacion(fAccidente, this.value);
                    }
                });
            }
        });

    </script>
}

<style>

