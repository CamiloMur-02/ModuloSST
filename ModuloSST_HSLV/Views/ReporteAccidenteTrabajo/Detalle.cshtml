@model ModuloSST_HSLV.Models.ReporteAccidenteTrabajo

@{
    ViewBag.Title = "Detalle — Accidente de Trabajo";
}

<div class="container" style="padding-top: 20px; padding-bottom: 50px;">

    @* --- CABECERA DE LA VISTA --- *@
    <div class="row" style="margin-bottom: 20px; display: flex; align-items: center;">
        <div class="col-md-8">
            <h2 class="text-primary" style="font-weight: bold; margin: 0;">
                <i class="glyphicon glyphicon-file"></i> Detalle del Reporte de Accidente
            </h2>
            <p class="text-muted" style="margin-top: 5px;">Visualización completa de la investigación y seguimiento.</p>
        </div>

        <div class="col-md-4 text-right">
            <a href="@Url.Action("Index", "ReporteAccidenteTrabajo")"
               class="btn btn-default"
               style="border: 2px solid #29235c; background: transparent; border-radius: 12px; color: #29235c; font-weight: bold; padding: 10px 20px;">
                <i class="glyphicon glyphicon-list"></i> Volver
            </a>

            <a href="@Url.Action("Editar", "ReporteAccidenteTrabajo", new { id = Model.IdReporteAccidenteTrabajo })"
               class="btn-verde-claro"
               style="display: inline-block; color: white; border-radius: 12px; font-weight: bold; margin-left: 5px; border: none; padding: 11px 20px; text-decoration: none;">
                <i class="glyphicon glyphicon-edit"></i> Editar Reporte
            </a>
        </div>
    </div>

    <hr />

    @* --- BLOQUE 1: DATOS DEL ACCIDENTADO --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-user"></i> 1. Datos del Accidentado
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <label class="detalle-label">Cédula</label>
                    <p class="detalle-texto">@Model.Cedula</p>
                </div>

                <div class="col-md-5">
                    <label class="detalle-label">Nombre Completo</label>
                    <p class="detalle-texto">@Model.NombreCompleto</p>
                </div>

                <div class="col-md-2">
                    <label class="detalle-label">Género</label>
                    <p class="detalle-texto">@Model.Genero</p>
                </div>

                <div class="col-md-2">
                    <label class="detalle-label">Edad</label>
                    <p class="detalle-texto">@Model.Edad años</p>
                </div>
            </div>

            <div class="row" style="margin-top:15px;">
                <div class="col-md-3">
                    <label class="detalle-label">Cargo</label>
                    <p class="detalle-texto">@Model.Cargo</p>
                </div>

                <div class="col-md-3">
                    <label class="detalle-label">Contratista</label>
                    <p class="detalle-texto">@(Model.Contratista ?? "N/A")</p>
                </div>

                <div class="col-md-3">
                    <label class="detalle-label">Tiempo Prestación</label>
                    <p class="detalle-texto">@(Model.TiempoPrestacion ?? "—")</p>
                </div>

                <div class="col-md-3">
                    <label class="detalle-label">N° Reporte Interno</label>
                    <p class="text-primary" style="font-weight: bold; margin-bottom: 0;">@Model.NumeroReporte</p>
                </div>
            </div>

            <div class="row" style="margin-top:15px;">
                <div class="col-md-6">
                    <label class="detalle-label">Proceso</label>
                    <p class="detalle-texto">@(Model.Proceso?.NombreProceso ?? "—")</p>
                </div>

                <div class="col-md-6">
                    <label class="detalle-label">Subproceso / Área</label>
                    <p class="detalle-texto">@(Model.Subproceso?.NombreSubproceso ?? "—")</p>
                </div>
            </div>
        </div>
    </div>

    @* --- BLOQUE 2: INFORMACIÓN DEL ACCIDENTE --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-exclamation-sign"></i> 2. Información del Suceso
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <label class="detalle-label">Fecha Accidente</label>
                    <p class="detalle-texto">@Model.FechaAT.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="col-md-3">
                    <label class="detalle-label">Fecha del Reporte</label>
                    <p class="detalle-texto">@(Model.FechaReporte.HasValue ? Model.FechaReporte.Value.ToString("dd/MM/yyyy") : "—")</p>
                </div>

                <div class="col-md-2">
                    <label class="detalle-label">Hora Exacta</label>
                    <p class="detalle-texto">@(Model.HoraAT.HasValue ? DateTime.Today.Add(Model.HoraAT.Value).ToString("hh:mm tt") : "—")</p>
                </div>

                <div class="col-md-2">
                    <label class="detalle-label">Tipo de Peligro</label>
                    <p>
                        <span class="label" style="background-color: #29235c; color: white; padding: 6px 10px; border-radius: 8px;">
                            @Model.TipoPeligro
                        </span>
                    </p>
                </div>

                <div class="col-md-2">
                    <label class="detalle-label">Días Incapacidad</label>
                    <p class="text-primary" style="font-weight: bold; margin-bottom: 0;">@Model.DiasIncapacidad</p>
                </div>
            </div>

            <div class="row" style="margin-top:15px;">
                <div class="col-md-2">
                    <label class="detalle-label">CIE-10</label>
                    <p class="detalle-texto"><strong>@(Model.CodigoDiagnostico ?? "—")</strong></p>
                </div>

                <div class="col-md-6">
                    <label class="detalle-label">Diagnóstico Médico</label>
                    <p class="detalle-texto">@Model.DetalleDiagnostico</p>
                </div>

                <div class="col-md-4">
                    <label class="detalle-label">Adjunto FURAT PDF</label>

                    @if (!string.IsNullOrEmpty(Model.NombreArchivoAccidente))
                    {
                        <a href="@Url.Action("Descargar", "ReporteAccidenteTrabajo", new { ruta = Model.RutaArchivoAccidente, nombre = Model.NombreArchivoAccidente })"
                           class="btn btn-sm"
                           style="background-color: #76b82a; color: white; border-radius: 10px; font-weight: bold; margin-top: 5px;">
                            <i class="glyphicon glyphicon-download-alt"></i> Descargar FURAT
                        </a>
                    }
                    else
                    {
                        <p class="text-muted"><i class="glyphicon glyphicon-ban-circle"></i> No se adjuntó archivo</p>
                    }
                </div>
            </div>

            <div style="margin-top: 20px; border-left: 4px solid #76b82a; padding: 15px; background: #f8f9fa; border-radius: 10px;">
                <label class="detalle-label">Relato de lo sucedido / Observaciones</label>
                <p style="font-style: italic; margin-bottom: 0;">"@Model.ObservacionesAccidente"</p>
            </div>
        </div>
    </div>

    @* --- BLOQUE 3: INVESTIGACIÓN --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-search"></i> 3. Investigación de Causa Raíz
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <label class="detalle-label">Fecha Investigación</label>
                    <p class="detalle-texto">@(Model.FechaInvestigacion?.ToString("dd/MM/yyyy") ?? "—")</p>
                </div>

                <div class="col-md-3">
                    <label class="detalle-label">Tiempo de Respuesta</label>
                    <p class="detalle-texto">@(Model.DiasInvestigacion ?? 0) días hábiles</p>
                </div>

                <div class="col-md-2">
                    <label class="detalle-label">Turno</label>
                    <p class="detalle-texto">@(Model.Turno ?? "—")</p>
                </div>

                <div class="col-md-4">
                    <label class="detalle-label">PDF de Investigación</label>

                    @if (!string.IsNullOrEmpty(Model.NombreArchivoInvestigacion))
                    {
                        <a href="@Url.Action("Descargar", "ReporteAccidenteTrabajo", new { ruta = Model.RutaArchivoInvestigacion, nombre = Model.NombreArchivoInvestigacion })"
                           class="btn btn-sm"
                           style="background-color: #76b82a; color: white; border-radius: 10px; font-weight: bold; margin-top: 5px;">
                            <i class="glyphicon glyphicon-paperclip"></i> Ver Investigación
                        </a>
                    }
                    else
                    {
                        <p class="text-muted"><i class="glyphicon glyphicon-ban-circle"></i> No se adjuntó archivo</p>
                    }
                </div>
            </div>

            <div class="row" style="margin-top:20px;">
                <div class="col-md-6">
                    <div style="border-left: 4px solid #29235c; padding-left: 15px;">
                        <label class="detalle-label">Causa Principal</label>
                        <p class="detalle-texto" style="font-weight: bold;">@(Model.Causa ?? "—")</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div style="border-left: 4px solid #76b82a; padding-left: 15px;">
                        <label class="detalle-label">Subcausa / Detalle</label>
                        <p class="detalle-texto">@(Model.Subcausa ?? "—")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- BLOQUE 4: PLAN DE MEJORA --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-ok"></i> 4. Plan de Mejora e Intervención
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row" style="margin-bottom: 15px;">
                <div class="col-md-4">
                    <label class="detalle-label">Líder Responsable</label>
                    <p class="detalle-texto">@(Model.Responsable ?? "No asignado")</p>
                </div>

                <div class="col-md-8">
                    <label class="detalle-label">Acción Correctiva / Preventiva</label>
                    <p class="detalle-texto">@(Model.IntervencionRealizar ?? "Sin definir")</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <label class="detalle-label">Fecha Límite Planeada</label>
                    <p class="detalle-texto">@(Model.FechaPlaneada.HasValue ? Model.FechaPlaneada.Value.ToString("dd/MM/yyyy") : "N/A")</p>
                </div>

                <div class="col-md-4">
                    <label class="detalle-label">Fecha de Ejecución</label>
                    <p class="detalle-texto">@(Model.FechaEjecucion.HasValue ? Model.FechaEjecucion.Value.ToString("dd/MM/yyyy") : "Pendiente")</p>
                </div>

                <div class="col-md-4">
                    <label class="detalle-label">PDF Plan de Mejora</label>

                    @if (!string.IsNullOrEmpty(Model.RutaArchivoPlan))
                    {
                        <a href="@Url.Content(Model.RutaArchivoPlan)"
                           target="_blank"
                           class="btn btn-sm"
                           style="background-color: #76b82a; color: white; border-radius: 10px; font-weight: bold;">
                            <i class="glyphicon glyphicon-paperclip"></i> Ver Documento
                        </a>
                    }
                    else
                    {
                        <p class="text-muted">No se adjuntó archivo</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* --- OBSERVACIONES FINALES --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-comment"></i> Observaciones Finales de Cierre
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <p class="detalle-texto">@(string.IsNullOrEmpty(Model.ObservacionesFinales) ? "Ninguna" : Model.ObservacionesFinales)</p>
        </div>
    </div>
</div>

<style>
    .detalle-label {
        color: #777;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: block;
        margin-bottom: 4px;
        font-weight: bold;
    }

    .detalle-texto {
        margin-bottom: 0;
        font-size: 15px;
        color: #333;
        font-weight: 600;
    }

    .btn-verde-claro {
        background-color: #76b82a;
        color: white;
    }

        .btn-verde-claro:hover {
            background-color: #5f9821;
            color: white;
            text-decoration: none;
        }
</style>