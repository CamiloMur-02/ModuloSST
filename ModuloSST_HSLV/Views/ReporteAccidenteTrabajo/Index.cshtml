@model IEnumerable<ModuloSST_HSLV.Models.ReporteAccidenteTrabajo>
@{
    ViewBag.Title = "Reportes de Accidente de Trabajo";
}

<div class="row">
    <div class="col-md-12">
        <h2 class="text-primary">Reportes de Accidente de Trabajo</h2>
        <hr />

        <div style="margin-bottom: 20px;">
            @Html.ActionLink("+ Registrar accidente", "Registrar", "ReporteAccidenteTrabajo",
                null, new { @class = "btn btn-success" })

            <a href="@Url.Action("Dashboard", "ReporteAccidenteTrabajo")" class="btn btn-primary">
                <i class="glyphicon glyphicon-stats"></i> Ver Dashboard / Indicadores
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr class="active">
                        <th>#</th>
                        <th>N° Reporte</th>
                        <th>Cédula</th>
                        <th>Apellidos y Nombre</th>
                        <th>Cargo</th>
                        <th>Proceso</th>
                        <th>Fecha AT</th>
                        <th>Tipo Peligro</th>
                        <th>Días Incap.</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted">No hay reportes registrados.</td></tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.NumeroReporte</td>
                                <td>@item.Cedula</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Cargo</td>
                                <td>@(item.Proceso != null ? item.Proceso.NombreProceso : "N/A")</td>
                                <td>@item.FechaAT.ToString("dd/MM/yyyy")</td>
                                <td>@item.TipoPeligro</td>
                                <td class="text-center">@item.DiasIncapacidad</td>
                                <td>
                                    <a href="@Url.Action("Detalle", "ReporteAccidenteTrabajo", new { id = item.IdReporteAccidenteTrabajo })"
                                       class="btn btn-sm btn-info">Ver</a>
                                    <a href="@Url.Action("Editar", "ReporteAccidenteTrabajo", new { id = item.IdReporteAccidenteTrabajo })"
                                       class="btn btn-sm btn-warning">Editar</a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>