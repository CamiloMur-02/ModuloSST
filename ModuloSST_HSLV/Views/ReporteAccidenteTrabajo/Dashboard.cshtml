@{
    ViewBag.Title = "Dashboard Accidentes de Trabajo";
}

<div class="container-fluid">
    <div class="row" style="margin-top: 20px;">
        <div class="col-md-8">
            <h2 class="mb-4">📊 Indicadores de Accidentes de Trabajo</h2>
        </div>
        <div class="col-md-4 text-right">
            <a href="@Url.Action("Index", "ReporteAccidenteTrabajo")" class="btn btn-default" style="border:1px solid #ccc;">
                <i class="glyphicon glyphicon-list"></i> Volver al Listado
            </a>
        </div>
    </div>
    <hr />

    <div class="panel panel-default shadow mb-4">
        <div class="panel-body">
            @using (Html.BeginForm("Dashboard", "ReporteAccidenteTrabajo", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="form-group" style="margin-right: 15px;">
                    <label>Año: </label>
                    <input type="number" name="anio" class="form-control" value="@ViewBag.AnioActual" style="width: 100px;" />
                </div>
                <div class="form-group" style="margin-right: 15px;">
                    <label>Trimestre: </label>
                    <select name="trimestre" class="form-control">
                        <option value="">Todos los trimestres</option>
                        <option value="1" @(ViewBag.TrimestreActual == 1 ? "selected" : "")>T1 (Ene-Mar)</option>
                        <option value="2" @(ViewBag.TrimestreActual == 2 ? "selected" : "")>T2 (Abr-Jun)</option>
                        <option value="3" @(ViewBag.TrimestreActual == 3 ? "selected" : "")>T3 (Jul-Sep)</option>
                        <option value="4" @(ViewBag.TrimestreActual == 4 ? "selected" : "")>T4 (Oct-Dic)</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Filtrar</button>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="panel panel-danger text-center" style="box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                <div class="panel-heading"><h4>Total Accidentes</h4></div>
                <div class="panel-body">
                    <h1 style="font-size: 50px; margin: 0;">@ViewBag.TotalAccidentes</h1>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="panel panel-warning text-center" style="box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                <div class="panel-heading"><h4>Días de Incapacidad</h4></div>
                <div class="panel-body">
                    <h1 style="font-size: 50px; margin: 0;">@ViewBag.TotalIncapacidad</h1>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="panel panel-default">
                <div class="panel-heading"><strong>Accidentes por Proceso (Top 5)</strong></div>
                <div class="panel-body"><canvas id="chartProcesos"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="panel panel-default">
                <div class="panel-heading"><strong>Distribución por Tipo de Peligro</strong></div>
                <div class="panel-body"><canvas id="chartPeligros"></canvas></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-info">
                <div class="panel-heading"><strong>Análisis de Causas Raíz Identificadas</strong></div>
                <div class="panel-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Causa</th>
                                <th class="text-center">Cantidad</th>
                                <th>Frecuencia Visual (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.EstadisticasCausas != null)
                            {
                                var listaCausas = (List<ModuloSST_HSLV.Controllers.EstadisticaItem>)ViewBag.EstadisticasCausas;
                                int totalAcc = ViewBag.TotalAccidentes ?? 0;

                                foreach (var item in listaCausas)
                                {
                                    var pct = totalAcc > 0 ? (item.Cantidad * 100) / totalAcc : 0;
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td class="text-center"><span class="label label-default">@item.Cantidad</span></td>
                                        <td>
                                            <div class="progress" style="height: 15px; margin-bottom: 0;">
                                                <div class="progress-bar progress-bar-info" role="progressbar" style="width: @pct%">
                                                    @pct%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Gráfico Procesos
    var dataProcesos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TopProcesos));
    new Chart(document.getElementById('chartProcesos'), {
        type: 'bar',
        data: {
            labels: dataProcesos.map(x => x.Nombre),
            datasets: [{
                label: 'Cantidad',
                data: dataProcesos.map(x => x.Cantidad),
                backgroundColor: '#337ab7'
            }]
        },
        options: { indexAxis: 'y', responsive: true }
    });

    // Gráfico Peligros
    var dataPeligros = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.EstadisticasPeligros));
    new Chart(document.getElementById('chartPeligros'), {
        type: 'doughnut',
        data: {
            labels: dataPeligros.map(x => x.Nombre),
            datasets: [{
                data: dataPeligros.map(x => x.Cantidad),
                backgroundColor: ['#d9534f', '#f0ad4e', '#5bc0de', '#5cb85c', '#777']
            }]
        }
    });
</script>