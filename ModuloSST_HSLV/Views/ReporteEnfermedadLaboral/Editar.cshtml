@model ModuloSST_HSLV.Models.ReporteEnfermedadLaboral

@{
    ViewBag.Title = "Editar Reporte de Enfermedad";
    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso>;
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso>;
    bool esLaboral = Model.TipoEnfermedad == "Enfermedad Laboral";
}

<h2 class="text-primary">Editar Reporte de Enfermedad</h2>
<p class="text-muted">Actualice la información del registro de @Model.NombreCompleto</p>
<hr />

@using (Html.BeginForm("Editar", "ReporteEnfermedadLaboral", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @* CAMPOS OCULTOS CRÍTICOS PARA QUE NO SE PIERDAN AL GUARDAR *@
    @Html.HiddenFor(m => m.IdReporteEnfermedadLaboral)
    @Html.HiddenFor(m => m.IdEmpleado)
    @Html.HiddenFor(m => m.FechaCreacion)

    @* --- SECCIÓN 1: DATOS DEL EMPLEADO --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-user"></i> 1. Datos del Empleado
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Cédula</label>
                        @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control", @readonly = "readonly", style = "border-radius: 10px; background-color: #f9f9f9;" })
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label>Nombre Completo</label>
                        @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Género</label>
                        <select name="Genero" class="form-control" style="border-radius: 10px;">
                            @if (ViewBag.Generos != null)
                            {
                                foreach (var g in ViewBag.Generos as string[])
                                {
                                    <option value="@g" @(Model.Genero == g ? "selected" : "")>@g</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Edad</label>
                        @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", type = "number", min = "0", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Cargo</label>
                        @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Contratista</label>
                        @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Tiempo Prestación</label>
                        @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Proceso</label>
                        <select name="IdProceso" class="form-control" style="border-radius: 10px;">
                            @if (procesos != null)
                            {
                                foreach (var p in procesos)
                                {
                                    <option value="@p.IdProceso" @(Model.IdProceso == p.IdProceso ? "selected" : "")>@p.NombreProceso</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Subproceso / Servicio / Área</label>
                        <select name="IdSubproceso" class="form-control" style="border-radius: 10px;">
                            @if (subprocesos != null)
                            {
                                foreach (var s in subprocesos)
                                {
                                    <option value="@s.IdSubproceso" @(Model.IdSubproceso == s.IdSubproceso ? "selected" : "")>@s.NombreSubproceso</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 2: DIAGNÓSTICO MÉDICO --- *@
    <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
        <div class="panel-heading" style="background-color: #76b82a; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                <i class="glyphicon glyphicon-list-alt"></i> 2. Diagnóstico Médico
            </h3>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Tipo de Enfermedad</label>
                        <select name="TipoEnfermedad" id="tipoEnfermedad" class="form-control" style="border-radius: 10px;">
                            @if (ViewBag.TiposEnfermedad != null)
                            {
                                foreach (var t in ViewBag.TiposEnfermedad as string[])
                                {
                                    <option value="@t" @(Model.TipoEnfermedad == t ? "selected" : "")>@t</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fecha de Diagnóstico</label>
                        @Html.TextBoxFor(m => m.FechaDiagnostico, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Código CIE-10</label>
                        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label>Días Incapacidad</label>
                        @Html.TextBoxFor(m => m.DiasIncapacidad, new { @class = "form-control", type = "number", min = "0", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Inicio Incapacidad</label>
                        @Html.TextBoxFor(m => m.FechaInicioIncapacidad, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Fin Incapacidad</label>
                        @Html.TextBoxFor(m => m.FechaFinalIncapacidad, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Detalle del Diagnóstico</label>
                        @Html.TextBoxFor(m => m.DetallesDiagnostico, new { @class = "form-control", style = "border-radius: 10px;" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN 3: INVESTIGACIÓN Y PLAN --- *@
    <div id="panelInvestigacion" style="display:@(esLaboral ? "block" : "none");">
        <div class="panel panel-default" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: none; margin-bottom: 30px;">
            <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 15px 15px 0 0; padding: 15px;">
                <h3 class="panel-title" style="font-weight: bold; font-size: 1.2em;">
                    <i class="glyphicon glyphicon-search"></i> 3. Investigación y Plan de Acción
                </h3>
            </div>

            <div class="panel-body" style="padding: 25px;">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Fecha de Investigación</label>
                            @Html.TextBoxFor(m => m.FechaInvestigacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Días de Investigación</label>
                            @Html.TextBoxFor(m => m.DiasInvestigacion, new { @class = "form-control", type = "number", min = "0", style = "border-radius: 10px;" })
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-group">
                            <label>Causa</label>
                            @Html.TextBoxFor(m => m.Causa, new { @class = "form-control", style = "border-radius: 10px;" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Responsable</label>
                            @Html.TextBoxFor(m => m.Responsable, new { @class = "form-control", style = "border-radius: 10px;" })
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="form-group">
                            <label>Actividad a Realizar</label>
                            @Html.TextBoxFor(m => m.ActividadARealizar, new { @class = "form-control", style = "border-radius: 10px;" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Fecha Planeada</label>
                            @Html.TextBoxFor(m => m.FechaPlaneada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Fecha de Ejecución</label>
                            @Html.TextBoxFor(m => m.FechaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Observaciones</label>
                            @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "2", style = "border-radius: 10px; resize: none;" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SECCIÓN DE BOTONES --- *@
    <div style="margin-bottom: 50px; display: flex; gap: 15px; align-items: center;">
        <button type="submit" class="btn-verde-claro" style="padding: 12px 30px; border-radius: 12px; font-weight: bold; border: none; font-size: 15px;">
            <i class="glyphicon glyphicon-floppy-disk"></i> Actualizar Reporte
        </button>

        <a href="@Url.Action("Index", "ReporteEnfermedadLaboral")"
           class="btn btn-default"
           style="border: 2px solid #29235c; background: transparent; border-radius: 12px; color: #29235c; font-weight: bold; padding: 10px 25px;">
            <i class="glyphicon glyphicon-remove"></i> Cancelar
        </a>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('tipoEnfermedad').addEventListener('change', function () {
            var panel = document.getElementById('panelInvestigacion');

            if (this.value === 'Enfermedad Laboral') {
                $(panel).slideDown();
            } else {
                $(panel).slideUp();
            }
        });
    </script>
}

<style>
    .btn-verde-claro {
        background-color: #76b82a;
        color: white;
    }

        .btn-verde-claro:hover {
            background-color: #5f9821;
            color: white;
        }
</style>