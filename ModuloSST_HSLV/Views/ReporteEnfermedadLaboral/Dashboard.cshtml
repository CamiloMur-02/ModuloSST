@using ModuloSST_HSLV.Models.ViewModels
@{
    ViewBag.Title = "Estadísticas de Salud";
}

<div class="container-fluid" style="padding: 20px;">
    @* --- TÍTULO --- *@
    <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-12">
            <h2 style="color: #29235c; font-weight: bold; margin: 0;">
                <i class="glyphicon glyphicon-stats" style="color: #76b82a;"></i> Dashboard Epidemiológico @DateTime.Now.Year
            </h2>
            <hr style="border-top: 2px solid #76b82a; width: 60px; margin: 10px 0;" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="panel panel-default" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="panel-heading" style="background-color: #29235c; color: white; border-radius: 12px 12px 0 0;">
                    <strong style="text-transform: uppercase; font-size: 0.9em;">
                        <i class="glyphicon glyphicon-th-list"></i> Distribución por Sistemas
                    </strong>
                </div>
                <div class="panel-body" style="max-height: 450px; overflow-y: auto; padding: 0;">
                    <div class="list-group" style="margin-bottom: 0;">
                        @if (ViewBag.Sistemas != null)
                        {
                            foreach (SistemaViewModel s in ViewBag.Sistemas)
                            {
                                <div class="list-group-item" style="border-left: none; border-right: none; padding: 15px 20px;">
                                    <span class="badge" style="background-color: #76b82a; font-size: 1.1em; padding: 6px 12px;">
                                        @s.TotalCasos <small style="color: white; font-size: 0.7em;">casos</small>
                                    </span>
                                    <h5 style="margin: 0; color: #29235c; font-weight: bold;">@s.NombreSistema</h5>
                                    <p style="margin: 5px 0 0 0; font-size: 0.85em;" class="text-muted">
                                        Total días incapacidad: <strong style="color: #d9534f;">@s.TotalDias</strong>
                                    </p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="panel-body text-center text-muted">No hay datos disponibles.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="panel panel-default" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="panel-heading" style="background-color: #f8f9fa; border-bottom: 2px solid #eee;">
                    <strong style="color: #29235c;"><i class="glyphicon glyphicon-alert"></i> Top 5 Diagnósticos (Mayor Incapacidad)</strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" style="margin-bottom: 0;">
                        <thead>
                            <tr style="background-color: #fcfcfc;">
                                <th style="border-bottom: none; color: #777;">CIE-10</th>
                                <th style="border-bottom: none; color: #777;">Descripción</th>
                                <th class="text-center" style="border-bottom: none; color: #777;">Días</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.TopDiagnosticos != null)
                            {
                                foreach (DiagnosticoViewModel d in ViewBag.TopDiagnosticos)
                                {
                                    <tr>
                                        <td style="vertical-align: middle;">
                                            <b style="color: #29235c; background: #eef2f7; padding: 4px 8px; border-radius: 4px;">@d.Codigo</b>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.9em; font-weight: 500; color: #444;">@d.Detalle</div>
                                        </td>
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span style="font-size: 1.1em; font-weight: bold; color: #d9534f;">@d.Dias</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-top: 10px;">
        <div class="panel-heading" style="background-color: #29235c; color: white;">
            <strong style="text-transform: uppercase;"><i class="glyphicon glyphicon-list-alt"></i> Seguimiento de Casos Laborales</strong>
        </div>
        <div class="table-responsive">
            <table class="table" style="margin-bottom: 0;">
                <thead style="background-color: #eef2f7;">
                    <tr>
                        <th class="text-center" style="color: #29235c; width: 100px;">Mes</th>
                        <th style="color: #29235c;">Colaborador</th>
                        <th style="color: #29235c;">Ubicación</th>
                        <th style="color: #29235c;">Análisis Causas</th>
                        <th class="text-center" style="color: #29235c; width: 80px;">Días</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.LaboralesDetalle != null)
                    {
                        foreach (var item in ViewBag.LaboralesDetalle)
                        {
                            <tr style="border-bottom: 1px solid #eee;">
                                <td class="text-center" style="vertical-align: middle; border-right: 1px solid #eee;">
                                    <div style="color: #29235c; font-weight: bold; font-size: 1.1em;">@item.FechaDiagnostico.ToString("MMM").ToUpper()</div>
                                    <span class="label" style="background-color: #76b82a;">Trim @(((item.FechaDiagnostico.Month - 1) / 3) + 1)</span>
                                </td>
                                <td style="vertical-align: middle;">
                                    <strong style="color: #333;">@item.NombreCompleto</strong><br />
                                    <span class="text-muted small">@item.Cargo</span>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span style="font-weight: 500;">@(item.Proceso != null ? item.Proceso.NombreProceso : "N/A")</span><br />
                                    <small class="text-muted">@(item.Subproceso != null ? item.Subproceso.NombreSubproceso : "N/A")</small>
                                </td>
                                <td style="vertical-align: middle;">
                                    @if (!string.IsNullOrEmpty(item.Causa))
                                    {
                                        <div style="background: #fff8e1; border-left: 3px solid #ffc107; padding: 4px 8px; font-size: 0.9em; margin-bottom: 4px;">
                                            <strong>Causa:</strong> @item.Causa
                                        </div>
                                    }
                                    <small class="text-muted"><i class="glyphicon glyphicon-info-sign"></i> @item.DetallesDiagnostico</small>
                                </td>
                                <td class="text-center" style="vertical-align: middle;">
                                    <span class="badge" style="background: #d9534f; font-weight: bold;">@item.DiasIncapacidad</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>