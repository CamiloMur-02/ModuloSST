@using ModuloSST_HSLV.Controllers
@{
    ViewBag.Title = "Dashboard de Bioseguridad";
    var estadisticasItems = ViewBag.EstadisticasItems as List<InspeccionBioseguridadController.EstadisticaBioseguridad>;
}

<div class="container-fluid">
    <div class="row" style="margin-top: 20px;">
        <div class="col-md-8">
            <h2 class="text-primary"><i class="glyphicon glyphicon-shield"></i> Indicadores de Bioseguridad</h2>
        </div>
        <div class="col-md-4 text-right">
            <a href="@Url.Action("Index")" class="btn btn-default"
               style="background-color: #29235c; color: white; border-radius: 10px; font-weight: bold; padding: 10px 20px;">
                <i class="glyphicon glyphicon-list"></i> Volver al Listado
            </a>
        </div>
    </div>
    <hr />

    @* Filtros *@
    <div class="panel panel-default">
        <div class="panel-body">
            @using (Html.BeginForm("Dashboard", "InspeccionBioseguridad", FormMethod.Get, new { @class = "form-inline" }))
            {
                <label>Año: </label>
                <input type="number" name="anio" class="form-control" value="@ViewBag.AnioActual" style="width: 100px; margin-right:15px;" />

                <label>Trimestre: </label>
                <select name="trimestre" class="form-control" style="margin-right:15px;">
                    <option value="">-- Todos los Trimestres --</option>
                    <option value="1" @(ViewBag.TrimestreActual == 1 ? "selected" : "")>T1 (Ene-Mar)</option>
                    <option value="2" @(ViewBag.TrimestreActual == 2 ? "selected" : "")>T2 (Abr-Jun)</option>
                    <option value="3" @(ViewBag.TrimestreActual == 3 ? "selected" : "")>T3 (Jul-Sep)</option>
                    <option value="4" @(ViewBag.TrimestreActual == 4 ? "selected" : "")>T4 (Oct-Dic)</option>
                </select>

                <button type="submit" class="btn" style="background-color: #76b82a; color: white; border-radius: 8px; font-weight: bold; padding: 6px 25px;">
                    <i class="glyphicon glyphicon-filter"></i> Aplicar Filtros
                </button>
            }
        </div>
    </div>

    @* Tabla de Adherencia por Ítem (Cantidad Exacta) *@
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading" style="background-color: #f5f5f5;">
                    <h3 class="panel-title"><strong>Cumplimiento Normativo por Ítem Evaluado</strong></h3>
                </div>
                <div class="panel-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Norma / Ítem de Bioseguridad</th>
                                <th class="text-center">Cumple (C)</th>
                                <th class="text-center">No Cumple (NC)</th>
                                <th style="width: 40%;">Porcentaje de Adherencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in estadisticasItems)
                            {
                                
                                var colorBarra = item.PorcentajeAdherencia >= 80 ? "#76b82a" : // Verde hospital
                                                (item.PorcentajeAdherencia >= 60 ? "#f0ad4e" : "#d9534f");
                                <tr>
                                    <td>@item.Nombre</td>
                                    @* Círculos de color sólido para C y NC *@
                                    <td class="text-center">
                                        <span style="background-color: #28a745; color: white; padding: 4px 10px; border-radius: 50%; font-weight: bold;">@item.Cumple</span>
                                    </td>
                                    <td class="text-center">
                                        <span style="background-color: #dc3545; color: white; padding: 4px 10px; border-radius: 50%; font-weight: bold;">@item.NoCumple</span>
                                    </td>
                                    <td>
                                        <div class="progress" style="margin-bottom:0; height: 18px; border-radius: 10px; background-color: #f1f1f1;">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width: @item.PorcentajeAdherencia.ToString("0")%; background-color: @colorBarra;">
                                                @item.PorcentajeAdherencia.ToString("0.0")%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* Gráficas de Procesos y Subprocesos *@
    <div class="row">
        <div class="col-md-6">
            <div class="panel panel-default">
                <div class="panel-heading"><strong>Adherencia por Proceso (%)</strong></div>
                <div class="panel-body">
                    <canvas id="chartProcesos" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="panel panel-default">
                <div class="panel-heading"><strong>Adherencia por Subproceso (%)</strong></div>
                <div class="panel-body">
                    <canvas id="chartSubprocesos" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* Scripts para Gráficas *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Configuración común para ambos gráficos
    const commonOptions = {
        indexAxis: 'y',
        responsive: true,
        plugins: {
            legend: { display: false } 
        },
        scales: {
            x: {
                beginAtZero: true,
                max: 100,
                title: { display: false } 
            }
        }
    };

    // Datos Procesos (Azul Oscuro Institucional)
    var dataProc = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AdherenciaProceso));
    new Chart(document.getElementById('chartProcesos'), {
        type: 'bar',
        data: {
            labels: dataProc.map(x => x.Nombre),
            datasets: [{
                data: dataProc.map(x => x.Porcentaje),
                backgroundColor: '#29235c', // Azul oscuro oficial
                borderRadius: 8
            }]
        },
        options: commonOptions
    });

    // Datos Subprocesos (Verde Institucional)
    var dataSub = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AdherenciaSubproceso));
    new Chart(document.getElementById('chartSubprocesos'), {
        type: 'bar',
        data: {
            labels: dataSub.map(x => x.Nombre),
            datasets: [{
                data: dataSub.map(x => x.Porcentaje),
                backgroundColor: '#76b82a', 
                borderRadius: 8
            }]
        },
        options: commonOptions
    });
</script>