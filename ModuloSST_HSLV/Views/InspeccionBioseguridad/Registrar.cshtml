@model ModuloSST_HSLV.Models.InspeccionBioseguridad
@{
    ViewBag.Title = "Registrar Inspección de Bioseguridad";
    var procesos = ViewBag.Procesos as List<ModuloSST_HSLV.Models.Proceso>;
    var subprocesos = ViewBag.Subprocesos as List<ModuloSST_HSLV.Models.Subproceso>;
}

@* Título principal en azul institucional *@
<h2 class="text-primary">Registrar Inspección de Bioseguridad</h2>
<hr />

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius: 12px;">
        <strong>Corrija los siguientes errores antes de guardar:</strong>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("Registrar", "InspeccionBioseguridad", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdEmpleado)

    <div class="form-container">
        <h3 class="text-primary" style="margin-bottom: 20px;">Datos del Colaborador</h3>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    @Html.LabelFor(m => m.Cedula)
                    @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control", style = "border-radius: 10px;" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.NombreCompleto)
                    @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", style = "border-radius: 10px;" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(m => m.Genero)
                    <select name="Genero" class="form-control" style="border-radius: 10px;">
                        <option value="">-- Género --</option>
                        @foreach (var g in ViewBag.Generos as string[])
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(m => m.Edad)
                    @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", type = "number", min = "0", style = "border-radius: 10px;" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.Cargo)
                    @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control", style = "border-radius: 10px;" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.Contratista)
                    @Html.TextBoxFor(m => m.Contratista, new { @class = "form-control", style = "border-radius: 10px;" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.TiempoPrestacion)
                    @Html.TextBoxFor(m => m.TiempoPrestacion, new { @class = "form-control", style = "border-radius: 10px;" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label>Proceso</label>
                    <select name="IdProceso" class="form-control" style="border-radius: 10px;">
                        <option value="">-- Seleccionar proceso --</option>
                        @foreach (var p in procesos)
                        {
                            <option value="@p.IdProceso">@p.NombreProceso</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>Subproceso / Servicio / Área</label>
                    <select name="IdSubproceso" class="form-control" style="border-radius: 10px;">
                        <option value="">-- Seleccionar subproceso --</option>
                        @foreach (var s in subprocesos)
                        {
                            <option value="@s.IdSubproceso">@s.NombreSubproceso</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.FechaInspeccion)
                    @Html.TextBoxFor(m => m.FechaInspeccion, "{0:yyyy-MM-dd}",
                        new { @class = "form-control", type = "date", style = "border-radius: 10px;" })
                </div>
            </div>
        </div>
    </div>

    <div class="form-container mt-4">
        <h3 class="text-primary" style="margin-bottom: 10px;">Evaluación de ítems de bioseguridad</h3>
        <p class="text-muted">
            <span class="label label-success">C</span> Cumple |
            <span class="label label-danger">NC</span> No Cumple |
            <span class="label label-default">NA</span> No Aplica
        </p>

        <div class="table-responsive">
            @* Tabla con el mismo encabezado azul de la lista *@
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ítem de Bioseguridad</th>
                        <th class="text-center" style="width:120px">C</th>
                        <th class="text-center" style="width:120px">NC</th>
                        <th class="text-center" style="width:120px">NA</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var items = new[]
                        {
                        new { label="Higiene de Manos",        campo="HigieneManos" },
                        new { label="Protección Respiratoria",  campo="ProteccionRespiratoria" },
                        new { label="Uso de Guantes",           campo="UsoGuantes" },
                        new { label="Uso de Gorro",             campo="UsoGorro" },
                        new { label="Uso de Bata",              campo="UsoBata" },
                        new { label="Protección Visual",        campo="ProteccionVisual" },
                        new { label="Uso Delantal/Peto",        campo="UsoDelantalPeto" },
                        new { label="Calzado Adecuado",         campo="CalzadoAdecuado" },
                        new { label="Transporte de Muestras",   campo="TransporteMuestras" },
                        new { label="Manejo Corto Punzantes",   campo="ManejoCorto" },
                        new { label="Manejo de Residuos",       campo="ManejoResiduos" },
                    }; }
                    @foreach (var item in items)
                    {
                        <tr>
                            <td style="font-weight: 500;">@item.label</td>
                            <td class="text-center"><input type="radio" name="@item.campo" value="C" checked /></td>
                            <td class="text-center"><input type="radio" name="@item.campo" value="NC" /></td>
                            <td class="text-center"><input type="radio" name="@item.campo" value="NA" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-container mt-4">
        <h3 class="text-primary">Observaciones Finales</h3>
        <div class="form-group">
            @Html.TextAreaFor(m => m.ObservacionesFinales, new { @class = "form-control", rows = "3", style = "border-radius: 10px;" })
        </div>
    </div>

    @* Botones finales con el verde institucional y el azul de retorno *@
    <div style="margin-top: 30px; margin-bottom: 50px;">
        <button type="submit" class="btn-verde-claro">Guardar Inspección</button>

        <a href="@Url.Action("Index", "InspeccionBioseguridad")"
           class="btn btn-default" style="border: 2px solid #29235c; background: transparent; border-radius: 12px; color: #29235c; font-weight: 600; padding: 8px 20px; margin-left: 10px;">
            Ver listado
        </a>
    </div>
}