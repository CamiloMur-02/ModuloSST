@model IEnumerable<ModuloSST_HSLV.Models.InspeccionBioseguridad>
@{ ViewBag.Title = "Inspecciones de Bioseguridad"; }

<div class="row">
    <div class="col-md-12">
        <h2 class="text-primary">Inspecciones de Bioseguridad</h2>
        <hr />

        <p>
            
            @Html.ActionLink("+ Registrar inspección", "Registrar", "InspeccionBioseguridad",
                null, new { @class = "btn-verde-claro" })
            
            <a href="@Url.Action("Dashboard", "InspeccionBioseguridad")" class="btn-dashboard">
                <i class="glyphicon glyphicon-stats"></i> Ver Indicadores / Dashboard
            </a>
        </p>

        <div class="table-responsive">
            
            <table class="table table-striped table-hover">
                <thead>
                    
                    <tr>
                        <th>#</th>
                        <th>Cédula</th>
                        <th>Apellidos y Nombres</th>
                        <th>Cargo</th>
                        <th>Proceso</th>
                        <th>Subproceso</th>
                        <th>Fecha</th>
                        <th class="text-center">C</th>
                        <th class="text-center">NC</th>
                        <th class="text-center">NA</th>
                        <th style="width: 100px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted">No hay inspecciones registradas.</td></tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td style="font-weight:bold">@item.Cedula</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Cargo</td>
                                <td>@(item.Proceso != null ? item.Proceso.NombreProceso : "N/A")</td>
                                <td>@(item.Subproceso != null ? item.Subproceso.NombreSubproceso : "N/A")</td>
                                <td>@item.FechaInspeccion.ToString("dd/MM/yyyy")</td>
                                @* Números de colores para C, NC, NA *@
                                <td class="text-center"><span class="text-success" style="font-size:1.1em"><strong>@item.TotalCumple</strong></span></td>
                                <td class="text-center"><span class="text-danger" style="font-size:1.1em"><strong>@item.TotalNoCumple</strong></span></td>
                                <td class="text-center text-muted">@item.TotalNoAplica</td>
                                <td class="text-center">
                                    <a href="@Url.Action("Detalle", "InspeccionBioseguridad", new { id = item.IdInspeccionBioseguridad })"
                                       class="btn-ver">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>