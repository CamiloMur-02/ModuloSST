<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema SST | HSLV</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @* Contenedor Principal: Logo Blanco + Barra Verde *@
    <div class="d-flex align-items-center" style="background-color: white; width: 100%;">

        @* 1. Bloque del Logo (Fondo Blanco) *@
        <div class="p-2" style="min-width: 180px; display: flex; justify-content: center; align-items: center;">
            <a href="@Url.Action("Index", "Home")">
                @* Ajustamos el logo para que sea protagonista como en la foto *@
                <img src="@Url.Content("~/Content/imagenes/logos_dos.png")"
                     alt="Logo Hospital"
                     style="height: 85px; width: auto;" />
            </a>
        </div>

        @* 2. Barra Verde (Navbar) *@
        <nav class="navbar navbar-expand-sm navbar-dark design-navbar flex-grow-1" style="margin-bottom: 0; padding-left: 20px;">
            <div class="container-fluid px-0">
                @* El nombre del Hospital empieza aquí, dentro de lo verde *@
                <span class="navbar-brand d-none d-md-inline" style="font-size: 22px; font-weight: bold; margin-right: 30px;">
                    Hospital Susana López de Valencia E.S.E.
                </span>

                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        title="Alternar navegación" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav">
                        <li>@Html.ActionLink("Evaluaciones", "Index", "Evaluacion", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Bioseguridad", "Index", "InspeccionBioseguridad", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Matriz EPP", "Index", "MatrizEpp", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Accidentes", "Index", "ReporteAccidenteTrabajo", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Enfermedades", "Index", "ReporteEnfermedadLaboral", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Incidentes", "Index", "ReporteIncidente", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Pausas Activas", "Index", "PausaActiva", new { area = "" }, new { @class = "nav-link" })</li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>

    <div class="container body-content" style="margin-top: 30px;">
        @* Mensajes de Alerta (Éxito/Error) *@
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-top: 20px;">
                <strong>&#10003; Éxito:</strong> @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-top: 20px;">
                <strong>&#9888; Error:</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()

        <hr />
        <footer class="text-center text-muted py-3 small">
            &copy; @DateTime.Now.Year — Hospital Susana López de Valencia
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>