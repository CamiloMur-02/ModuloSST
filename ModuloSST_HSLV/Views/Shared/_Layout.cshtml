<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema SST | HSLV</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    
    <style>
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100%;
        }

        
        .design-navbar {
            background-color: #2e7d32 !important; 
            border: none !important;
            border-radius: 0 !important;
            margin-bottom: 0 !important;
        }

        .nav-link {
            color: white !important;
            font-size: 14px;
        }

            .nav-link:hover {
                background-color: rgba(255,255,255,0.1);
                border-radius: 4px;
            }
    </style>
</head>
<body>
    
    <header style="width: 100%;">
        <div class="d-flex align-items-stretch" style="background-color: white; width: 100%;">

            @* Bloque del Logo Hospital (Fondo Blanco) *@
            <div style="min-width: 200px; display: flex; justify-content: center; align-items: center; padding: 10px;">
                <a href="@Url.Action("Index", "Home")">
                    <img src="@Url.Content("~/Content/imagenes/logos_dos.png")"
                         alt="Logo Hospital"
                         style="height: 80px; width: auto;" />
                </a>
            </div>

            @* Barra Verde (Navbar) *@
            <nav class="navbar navbar-expand-lg navbar-dark design-navbar flex-grow-1" style="padding: 0 20px;">
                <div class="container-fluid">
                    <span class="navbar-brand d-none d-xl-inline" style="font-size: 18px; font-weight: bold; margin-right: 20px;">
                        Hospital Susana López de Valencia E.S.E.
                    </span>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">@Html.ActionLink("Evaluaciones", "Index", "Evaluacion", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Bioseguridad", "Index", "InspeccionBioseguridad", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Matriz EPP", "Index", "MatrizEpp", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Accidentes", "Index", "ReporteAccidenteTrabajo", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Enfermedades", "Index", "ReporteEnfermedadLaboral", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Incidentes", "Index", "ReporteIncidente", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Pausas Activas", "Index", "PausaActiva", null, new { @class = "nav-link" })</li>
                        </ul>

                        
                        <div class="d-flex align-items-center ms-3">
                            <div style="background-color: white;
                                    padding: 5px 15px;
                                    border-radius: 8px;
                                    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
                                    display: flex;
                                    align-items: center;
                                    height: 70px;">
                                    <img src="@Url.Content("~/Content/imagenes/logo_uni.png")"
                                     alt="Unicomfacauca"
                                     style="height: 50px; width: auto;" /> @* Sin filtros para mantener naranja y azul *@

                             </div>
                       </div>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    @* --- PASO 3: CONTENIDO --- *@
    <div class="container body-content" style="margin-top: 30px;">
        

        @RenderBody()

        <hr />
        <footer class="text-center text-muted py-3 small">
            &copy; @DateTime.Now.Year — Hospital Susana López de Valencia
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>