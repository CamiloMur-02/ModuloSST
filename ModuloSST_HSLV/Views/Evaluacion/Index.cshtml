@model IEnumerable<ModuloSST_HSLV.Models.Evaluacion>
@{ ViewBag.Title = "Evaluaciones"; }

<div class="row">
    <div class="col-md-12">
        
        <h2 class="text-primary">Evaluaciones Cargadas</h2>
        <hr />

        <p>
            
            @Html.ActionLink("+ Cargar nueva evaluación", "Crear", "Evaluacion",
                null, new { @class = "btn-verde-claro" })
        </p>

        <div class="table-responsive">
            
            <table class="table table-striped table-hover">
                <thead>
                    
                    <tr>
                        <th class="text-center">#</th>
                        <th>Tipo de Evaluación</th>
                        <th>Nombre del Archivo</th>
                        <th class="text-center">Fecha de Carga</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No hay evaluaciones cargadas todavía.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@i</td>
                                <td style="font-weight: bold;">@item.TipoEvaluacion</td>
                                <td>@item.NombreArchivo</td>
                                <td class="text-center">@item.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    
                                    @Html.ActionLink("Descargar", "VerArchivo", "Evaluacion",
                                        new { id = item.IdEvaluacion },
                                        new { @class = "btn-descargar", target = "_blank" })
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>