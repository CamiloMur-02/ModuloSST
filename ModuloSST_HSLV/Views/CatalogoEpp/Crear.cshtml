@model ModuloSST_HSLV.Models.CatalogoEpp
@{ ViewBag.Title = "Agregar tipo de EPP"; }
<h2 class="text-primary">Agregar tipo de EPP</h2>
<hr />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Corrija los siguientes errores:</strong>
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
        </div>
    }
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="form-group">
                @Html.LabelFor(m => m.NombreEPP)
                @Html.TextBoxFor(m => m.NombreEPP,
                    new { @class = "form-control", placeholder = "Ej: Monogafas" })
                @Html.ValidationMessageFor(m => m.NombreEPP, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>@Html.CheckBoxFor(m => m.Estado) Activo</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Cancelar", "Index", "CatalogoEpp",
                null, new { @class = "btn btn-default" })
        </div>
    </div>
}